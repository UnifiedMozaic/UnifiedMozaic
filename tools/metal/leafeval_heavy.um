// 探索の末端の評価の形で、1回の評価が重い場合（調査用。テストではない）。
// 1回の呼び出しで 1024 局面を評価し、1局面あたり 2048 回の積和を行う。毎回答えを読んで次の入力を決める。
//   UM_METAL=1 node src/cli.ts build tools/metal/leafeval_heavy.um --target host -o out/mac-check/leafeval_heavy
//   time out/mac-check/leafeval_heavy                        GPU、常駐（待機 kernel）あり
//   time env UM_GPU_RESIDENT=0 out/mac-check/leafeval_heavy  GPU、常駐なし
//   time env UM_GPU=0 out/mac-check/leafeval_heavy           CPU（全コア）
kernel function score(i: u32, out: mut Buffer<i32>, pos: Buffer<i32>, w: Buffer<i32>, bias: i32): void {
  let acc = bias;
  for (let k: u32 = 0; k < 2048; k++) {
    acc = acc + pos[i * 64 + (k & 63)] * w[k & 63] + ((acc >> 3) ^ (k as i32));
  }
  out[i] = acc;
}

export function main(): i32 {
  const leaves: u32 = 1024;
  let pos = new Buffer<i32>(leaves * 64);
  let w = new Buffer<i32>(64);
  for (let k: u32 = 0; k < 64; k++) {
    w[k] = (k as i32) * 3 - 90;
  }
  let out = new Buffer<i32>(leaves);
  let best: i32 = 0;
  let sum: i64 = 0;
  for (let round: u32 = 0; round < 3000; round++) {
    for (let i: u32 = 0; i < leaves * 64; i += 257) {
      pos[i] = (best + (i as i32) + (round as i32)) % 97;
    }
    // 実行先は自動判断に任せる（UM_GPU=0 なら CPU）。しきい値より少ないので、GPU を候補にするよう下げて使う。
    dispatch(score, leaves, mut out, pos, w, round as i32);
    best = out[0];
    for (let i: u32 = 1; i < leaves; i++) {
      if (out[i] > best) {
        best = out[i];
      }
    }
    sum += best as i64;
  }
  print(sum);
  return 0;
}
