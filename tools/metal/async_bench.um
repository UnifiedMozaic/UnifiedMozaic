// gpu.submit で、いくつかの評価を同時に GPU に預けておく形の計測（調査用。テストではない）。
// 評価の中身は tools/metal/leafeval.um と同じ（32 局面 × 64 回の積和）。IN_FLIGHT 個（1〜8）の評価を預けたまま、
// 古い順に結果を受け取っては次を投げる。毎回、受け取った答えから次の入力を作る。
//   UM_METAL=1 node src/cli.ts build tools/metal/async_bench.um --target host -o out/mac-check/async_bench
//   time out/mac-check/async_bench
kernel function score(i: u32, out: mut RacyBuffer<i32>, pos: RacyBuffer<i32>, w: RacyBuffer<i32>, bias: i32): void {
  let acc = bias;
  for (let k: u32 = 0; k < 64; k++) {
    acc = acc + pos[i * 64 + k] * w[k] + ((acc >> 3) ^ (k as i32));
  }
  out[i] = acc;
}

// 前の答えから次の局面を作る。
function prepare(pos: mut RacyBuffer<i32>, best: i32, round: u32): void {
  for (let i: u32 = 0; i < 32 * 64; i += 17) {
    pos[i] = (best + (i as i32) + (round as i32)) % 97;
  }
}

function bestOf(out: RacyBuffer<i32>): i32 {
  let best = out[0];
  for (let i: u32 = 1; i < 32; i++) {
    if (out[i] > best) {
      best = out[i];
    }
  }
  return best;
}

export function main(): i32 {
  const leaves: u32 = 32;
  let w = new RacyBuffer<i32>(64);
  for (let k: u32 = 0; k < 64; k++) {
    w[k] = (k as i32) * 3 - 90;
  }
  const IN_FLIGHT: u32 = 4;
  let pos0 = new RacyBuffer<i32>(leaves * 64);
  let out0 = new RacyBuffer<i32>(leaves);
  let t0: u64 = 0;
  let busy0 = false;
  let pos1 = new RacyBuffer<i32>(leaves * 64);
  let out1 = new RacyBuffer<i32>(leaves);
  let t1: u64 = 0;
  let busy1 = false;
  let pos2 = new RacyBuffer<i32>(leaves * 64);
  let out2 = new RacyBuffer<i32>(leaves);
  let t2: u64 = 0;
  let busy2 = false;
  let pos3 = new RacyBuffer<i32>(leaves * 64);
  let out3 = new RacyBuffer<i32>(leaves);
  let t3: u64 = 0;
  let busy3 = false;
  let pos4 = new RacyBuffer<i32>(leaves * 64);
  let out4 = new RacyBuffer<i32>(leaves);
  let t4: u64 = 0;
  let busy4 = false;
  let pos5 = new RacyBuffer<i32>(leaves * 64);
  let out5 = new RacyBuffer<i32>(leaves);
  let t5: u64 = 0;
  let busy5 = false;
  let pos6 = new RacyBuffer<i32>(leaves * 64);
  let out6 = new RacyBuffer<i32>(leaves);
  let t6: u64 = 0;
  let busy6 = false;
  let pos7 = new RacyBuffer<i32>(leaves * 64);
  let out7 = new RacyBuffer<i32>(leaves);
  let t7: u64 = 0;
  let busy7 = false;
  let sum: i64 = 0;
  let best: i32 = 0;
  const rounds: u32 = 20000;
  for (let round: u32 = 0; round < rounds; round++) {
    const s = round % IN_FLIGHT;
    if (s == 0) {
      if (busy0) {
        gpu.wait(t0);
        best = bestOf(out0);
        sum += best as i64;
      }
      prepare(mut pos0, best, round);
      t0 = gpu.submit(score, leaves, mut out0, pos0, w, round as i32);
      busy0 = true;
    } else if (s == 1) {
      if (busy1) {
        gpu.wait(t1);
        best = bestOf(out1);
        sum += best as i64;
      }
      prepare(mut pos1, best, round);
      t1 = gpu.submit(score, leaves, mut out1, pos1, w, round as i32);
      busy1 = true;
    } else if (s == 2) {
      if (busy2) {
        gpu.wait(t2);
        best = bestOf(out2);
        sum += best as i64;
      }
      prepare(mut pos2, best, round);
      t2 = gpu.submit(score, leaves, mut out2, pos2, w, round as i32);
      busy2 = true;
    } else if (s == 3) {
      if (busy3) {
        gpu.wait(t3);
        best = bestOf(out3);
        sum += best as i64;
      }
      prepare(mut pos3, best, round);
      t3 = gpu.submit(score, leaves, mut out3, pos3, w, round as i32);
      busy3 = true;
    } else if (s == 4) {
      if (busy4) {
        gpu.wait(t4);
        best = bestOf(out4);
        sum += best as i64;
      }
      prepare(mut pos4, best, round);
      t4 = gpu.submit(score, leaves, mut out4, pos4, w, round as i32);
      busy4 = true;
    } else if (s == 5) {
      if (busy5) {
        gpu.wait(t5);
        best = bestOf(out5);
        sum += best as i64;
      }
      prepare(mut pos5, best, round);
      t5 = gpu.submit(score, leaves, mut out5, pos5, w, round as i32);
      busy5 = true;
    } else if (s == 6) {
      if (busy6) {
        gpu.wait(t6);
        best = bestOf(out6);
        sum += best as i64;
      }
      prepare(mut pos6, best, round);
      t6 = gpu.submit(score, leaves, mut out6, pos6, w, round as i32);
      busy6 = true;
    } else if (s == 7) {
      if (busy7) {
        gpu.wait(t7);
        best = bestOf(out7);
        sum += best as i64;
      }
      prepare(mut pos7, best, round);
      t7 = gpu.submit(score, leaves, mut out7, pos7, w, round as i32);
      busy7 = true;
    }
  }
  if (busy0) {
    gpu.wait(t0);
    sum += bestOf(out0) as i64;
  }
  if (busy1) {
    gpu.wait(t1);
    sum += bestOf(out1) as i64;
  }
  if (busy2) {
    gpu.wait(t2);
    sum += bestOf(out2) as i64;
  }
  if (busy3) {
    gpu.wait(t3);
    sum += bestOf(out3) as i64;
  }
  if (busy4) {
    gpu.wait(t4);
    sum += bestOf(out4) as i64;
  }
  if (busy5) {
    gpu.wait(t5);
    sum += bestOf(out5) as i64;
  }
  if (busy6) {
    gpu.wait(t6);
    sum += bestOf(out6) as i64;
  }
  if (busy7) {
    gpu.wait(t7);
    sum += bestOf(out7) as i64;
  }
  print(sum);
  return 0;
}
