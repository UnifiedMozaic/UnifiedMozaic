// 浮動小数点の演算ごとに、CPU と GPU（Metal）の結果が何個ずれるかを数える（調査用。テストではない）。
// 1行に「演算の番号」「ずれた個数」「ずれの最大（ビット列の差）」を出す。
//  1: x * k + y        （積和。GPU がまとめて1回で計算すると丸めが変わる）
//  2: x * k            （積だけ）
//  3: x + y            （和だけ）
//  4: y / (x + 1.5)    （割り算）
//  5: sqrt(|y|)
//  6: floor(y * 0.5)
//  7: ceil(x * 0.25)
//  8: min / max / abs
//  9: 1 の式全体（tests/metal/parity.um の arith と同じ）

kernel function op1(i: u32, out: mut Buffer<f32>, x: Buffer<f32>, y: Buffer<f32>, k: f32): void { out[i] = x[i] * k + y[i]; }
kernel function op2(i: u32, out: mut Buffer<f32>, x: Buffer<f32>, y: Buffer<f32>, k: f32): void { out[i] = x[i] * k; }
kernel function op3(i: u32, out: mut Buffer<f32>, x: Buffer<f32>, y: Buffer<f32>, k: f32): void { out[i] = x[i] + y[i]; }
kernel function op4(i: u32, out: mut Buffer<f32>, x: Buffer<f32>, y: Buffer<f32>, k: f32): void { out[i] = y[i] / (x[i] + 1.5); }
kernel function op5(i: u32, out: mut Buffer<f32>, x: Buffer<f32>, y: Buffer<f32>, k: f32): void { out[i] = Math.sqrt(Math.abs(y[i])); }
kernel function op6(i: u32, out: mut Buffer<f32>, x: Buffer<f32>, y: Buffer<f32>, k: f32): void { out[i] = Math.floor(y[i] * 0.5); }
kernel function op7(i: u32, out: mut Buffer<f32>, x: Buffer<f32>, y: Buffer<f32>, k: f32): void { out[i] = Math.ceil(x[i] * 0.25); }
kernel function op8(i: u32, out: mut Buffer<f32>, x: Buffer<f32>, y: Buffer<f32>, k: f32): void {
  out[i] = Math.max(Math.min(x[i], 1000), -1000) + Math.abs(x[i] - y[i]);
}
kernel function op9(i: u32, out: mut Buffer<f32>, x: Buffer<f32>, y: Buffer<f32>, k: f32): void {
  const v = x[i] * k + y[i] / (x[i] + 1.5) - Math.floor(y[i] * 0.5);
  out[i] = Math.max(Math.min(v, 1000), -1000) + Math.abs(x[i] - y[i]) + Math.sqrt(Math.abs(y[i])) + Math.ceil(x[i] * 0.25);
}

// f32 のビット列を整数として読む（kernel の外では型変換でビット列は取れないので、差の大きさを別の形で測る）。
function report(op: i32, a: Buffer<f32>, b: Buffer<f32>): void {
  let bad: u32 = 0;
  let worst: f64 = 0;
  for (let i: u32 = 0; i < a.length; i++) {
    // 両方が NaN のときは同じとみなす。
    if (a[i] != b[i] && !(a[i] != a[i] && b[i] != b[i])) {
      bad += 1;
      // 相対的な差。1 ビットの差はおよそ 1.2e-7。
      const d = Math.abs((a[i] as f64) - (b[i] as f64)) / Math.max(Math.abs(a[i] as f64), 1e-30);
      worst = Math.max(worst, d);
    }
  }
  print(`${op}: ${bad} ${worst}`);
}

export function main(): i32 {
  const n: u32 = 50000;
  let seed: u32 = 12345;
  let xs = new Buffer<f32>(n);
  let ys = new Buffer<f32>(n);
  for (let i: u32 = 0; i < n; i++) {
    seed = seed * 1664525 + 1013904223;
    xs[i] = (((seed >> 8) % 2000) as f32) * 0.01 - 5;
    seed = seed * 1664525 + 1013904223;
    ys[i] = (((seed >> 8) % 3000) as f32) * 0.02 - 30;
    seed = seed * 1664525 + 1013904223;
    seed = seed * 1664525 + 1013904223;
    seed = seed * 1664525 + 1013904223;
  }
  let a = new Buffer<f32>(n);
  let b = new Buffer<f32>(n);
  cpu.dispatch(op1, n, mut a, xs, ys, 1.75);
  gpu.dispatch(op1, n, mut b, xs, ys, 1.75);
  report(1, a, b);
  cpu.dispatch(op2, n, mut a, xs, ys, 1.75);
  gpu.dispatch(op2, n, mut b, xs, ys, 1.75);
  report(2, a, b);
  cpu.dispatch(op3, n, mut a, xs, ys, 1.75);
  gpu.dispatch(op3, n, mut b, xs, ys, 1.75);
  report(3, a, b);
  cpu.dispatch(op4, n, mut a, xs, ys, 1.75);
  gpu.dispatch(op4, n, mut b, xs, ys, 1.75);
  report(4, a, b);
  cpu.dispatch(op5, n, mut a, xs, ys, 1.75);
  gpu.dispatch(op5, n, mut b, xs, ys, 1.75);
  report(5, a, b);
  cpu.dispatch(op6, n, mut a, xs, ys, 1.75);
  gpu.dispatch(op6, n, mut b, xs, ys, 1.75);
  report(6, a, b);
  cpu.dispatch(op7, n, mut a, xs, ys, 1.75);
  gpu.dispatch(op7, n, mut b, xs, ys, 1.75);
  report(7, a, b);
  cpu.dispatch(op8, n, mut a, xs, ys, 1.75);
  gpu.dispatch(op8, n, mut b, xs, ys, 1.75);
  report(8, a, b);
  cpu.dispatch(op9, n, mut a, xs, ys, 1.75);
  gpu.dispatch(op9, n, mut b, xs, ys, 1.75);
  report(9, a, b);
  return 0;
}
