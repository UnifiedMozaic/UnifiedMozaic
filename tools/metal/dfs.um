// 深さ優先探索（ミニマックス）の末端の評価を kernel で行う（調査用。テストではない）。
// 分岐 8、深さ 5 の木（末端 32768 個）。末端の評価は1個あたり 1024 回の計算。
// LEVELS は「末端から何段ぶんをまとめて1回の dispatch で評価するか」。
//   0: 末端を1個ずつ評価する（dispatch 32768 回）
//   1: 末端の親で、子 8 個をまとめて評価する（4096 回）
//   2: 64 個ずつ（512 回）   3: 512 個ずつ（64 回）   5: 全部を1回で
// どの設定でも答え（根の評価値）は同じになる。
//   sed 's/const LEVELS: u32 = 2;/const LEVELS: u32 = 3;/' tools/metal/dfs.um > out/mac-check/dfs3.um
//   UM_METAL=1 node src/cli.ts build out/mac-check/dfs3.um --target host -o out/mac-check/dfs3
//   time out/mac-check/dfs3              実行先は自動判断
//   time env UM_GPU=0 out/mac-check/dfs3  CPU だけ

kernel function evalLeaf(i: u32, out: mut Buffer<i32>, ids: Buffer<u32>): void {
  let h: u32 = ids[i] * 2654435761 + 12345;
  for (let k: u32 = 0; k < 1024; k++) {
    h = (h * 1664525 + 1013904223) ^ (h >> 13) ^ k;
  }
  out[i] = (((h >> 8) % 2001) as i32) - 1000;
}

function pow8(n: u32): u32 {
  let r: u32 = 1;
  for (let i: u32 = 0; i < n; i++) {
    r = r * 8;
  }
  return r;
}

// node の下、levels 段先の末端をすべて評価し、ミニマックスで node の値にまとめる。
function evalSubtree(node: u32, levels: u32, maxing: bool, ids: mut Buffer<u32>, vals: mut Buffer<i32>): i32 {
  let first = node;
  for (let l: u32 = 0; l < levels; l++) {
    first = first * 8 + 1;
  }
  let len = pow8(levels);
  for (let i: u32 = 0; i < len; i++) {
    ids[i] = first + i;
  }
  dispatch(evalLeaf, len, mut vals, ids);
  // 下の段から順に、8 個ずつ最大か最小を取る。
  let level = levels;
  while (len > 1) {
    level -= 1;
    let takeMax = maxing;
    if (level % 2 == 1) {
      takeMax = !maxing;
    }
    const groups = len / 8;
    for (let g: u32 = 0; g < groups; g++) {
      let best = vals[g * 8];
      for (let c: u32 = 1; c < 8; c++) {
        const v = vals[g * 8 + c];
        if (takeMax) {
          if (v > best) {
            best = v;
          }
        } else {
          if (v < best) {
            best = v;
          }
        }
      }
      vals[g] = best;
    }
    len = groups;
  }
  return vals[0];
}

function search(node: u32, remaining: u32, levels: u32, maxing: bool, ids: mut Buffer<u32>, vals: mut Buffer<i32>): i32 {
  if (remaining <= levels) {
    return evalSubtree(node, remaining, maxing, mut ids, mut vals);
  }
  let best: i32 = 0;
  for (let c: u32 = 0; c < 8; c++) {
    const v = search(node * 8 + c + 1, remaining - 1, levels, !maxing, mut ids, mut vals);
    if (c == 0) {
      best = v;
    } else if (maxing) {
      if (v > best) {
        best = v;
      }
    } else {
      if (v < best) {
        best = v;
      }
    }
  }
  return best;
}

export function main(): i32 {
  const LEVELS: u32 = 2;
  const depth: u32 = 5;
  let ids = new Buffer<u32>(pow8(depth));
  let vals = new Buffer<i32>(pow8(depth));
  // 探索を 20 回くり返す（1回だけでは短すぎて測りにくい）。
  let sum: i64 = 0;
  for (let round: u32 = 0; round < 20; round++) {
    sum += search(round, depth, LEVELS, true, mut ids, mut vals) as i64;
  }
  print(sum);
  return 0;
}
