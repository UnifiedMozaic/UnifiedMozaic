// thread.spawn / spawnEach / join の手間の計測（調査用。テストではない）。
//   node src/cli.ts build tools/threads_bench.um --target host -o out/threads_bench && out/threads_bench
function nothing(x: u32): u32 {
  return x + 1;
}

export function main(): i32 {
  const n: u32 = 20000;
  // 1本ずつ起動して合流する。
  let t0 = clock();
  let acc: u32 = 0;
  for (let i: u32 = 0; i < n; i++) {
    const h = thread.spawn(nothing, i);
    acc += thread.join(h);
  }
  const one = (clock() - t0) / (n as f64);
  print(`spawn+join 1 thread: ${one * 1e6} us`);

  // 8本まとめて起動して合流する。
  t0 = clock();
  for (let i: u32 = 0; i < n / 8; i++) {
    let ks: u32[] = [0, 1, 2, 3, 4, 5, 6, 7];
    const g = thread.spawnEach(nothing, own ks);
    const rs = thread.join(g);
    acc += rs[7];
  }
  const eight = (clock() - t0) / ((n / 8) as f64);
  print(`spawnEach+join 8 threads: ${eight * 1e6} us (${eight * 1e6 / 8} us per thread)`);

  // 64本まとめて。
  t0 = clock();
  for (let i: u32 = 0; i < 200; i++) {
    let ks: u32[] = [];
    for (let k: u32 = 0; k < 64; k++) {
      ks.push(k);
    }
    const g = thread.spawnEach(nothing, own ks);
    const rs = thread.join(g);
    acc += rs[63];
  }
  const many = (clock() - t0) / 200.0;
  print(`spawnEach+join 64 threads: ${many * 1e6} us (${many * 1e6 / 64} us per thread)`);
  print(acc);
  return 0;
}
