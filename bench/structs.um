// 構造体の配列（T[]）を、ループで繰り返し更新する。
struct Particle {
  x: f64;
  y: f64;
  vx: f64;
  vy: f64;
  hits: u32;
}

function update(ps: mut Particle[], dt: f64): void {
  for (let i: usize = 0; i < ps.length; i++) {
    ps[i].x += ps[i].vx * dt;
    ps[i].y += ps[i].vy * dt;
    if (ps[i].x < 0.0 || ps[i].x > 1000.0) {
      ps[i].vx = -ps[i].vx;
      ps[i].hits += 1;
    }
    if (ps[i].y < 0.0 || ps[i].y > 1000.0) {
      ps[i].vy = -ps[i].vy;
      ps[i].hits += 1;
    }
  }
}

export function main(): i32 {
  const n: usize = 100000;
  let ps = new Array<Particle>(0);
  for (let i: usize = 0; i < n; i++) {
    const k = (i % 1000) as f64;
    ps.push({ x: k, y: (999 - i % 1000) as f64, vx: ((i % 7) as f64) - 3.0, vy: ((i % 11) as f64) - 5.0, hits: 0 });
  }
  for (let t = 0; t < 2000; t++) {
    update(mut ps, 0.5);
  }
  let hits: u64 = 0;
  let sx: f64 = 0;
  for (let i: usize = 0; i < n; i++) {
    hits += ps[i].hits as u64;
    sx += ps[i].x + ps[i].y;
  }
  print(hits);
  print(sx as u64);
  return 0;
}
