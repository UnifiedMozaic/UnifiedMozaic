// kernel + Buffer<f32> の dispatch（3点ブラー + saxpy）を繰り返す。
kernel function blur(i: u32, out: mut Buffer<f32>, src: Buffer<f32>): void {
  let left = i;
  if (i > 0) {
    left = i - 1;
  }
  out[i] = (src[left] + src[i] + src[i + 1]) * 0.33333334;
}

kernel function saxpy(i: u32, y: mut Buffer<f32>, x: Buffer<f32>, a: f32): void {
  y[i] = a * x[i] + y[i];
}

export function main(): i32 {
  const n: u32 = 4194304;
  let a = new Buffer<f32>(n);
  let b = new Buffer<f32>(n);
  for (let i: u32 = 0; i < n; i++) {
    a[i] = ((i * 7919) % 1000) as f32;
  }
  for (let t = 0; t < 60; t++) {
    dispatch(blur, n, mut b, a);
    dispatch(blur, n, mut a, b);
    dispatch(saxpy, n, mut a, b, 0.001);
  }
  let sum: f64 = 0;
  for (const v of a) {
    sum += v as f64;
  }
  print(sum as u64);
  return 0;
}
