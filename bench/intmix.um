// xorshift64 と 32bit の混ぜ合わせを繰り返すスカラー整数ループ（配列なし）。
export function main(): i32 {
  let x: u64 = 88172645463325252;
  let acc: u32 = 2166136261;
  let sum: u64 = 0;
  for (let i: u32 = 0; i < 400000000; i++) {
    x ^= x << 13;
    x ^= x >> 7;
    x ^= x << 17;
    acc = (acc ^ ((x >> 32) as u32)) * 16777619;
    acc = (acc << 5) | (acc >> 27);
    sum += (acc & 255) as u64;
  }
  print(x);
  print(acc);
  print(sum);
  return 0;
}
