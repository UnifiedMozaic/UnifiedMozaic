// readLine はメインスレッドだけ（標準入力のバッファは1つ）。
function readOne(n: i32): i32 {
  const line = readLine();
  return n;
}

export function main(): i32 {
  const h = thread.spawn(readOne, 1);
  print(thread.join(h));
  return 0;
}

