    show("pal2-adam7", d);
  }
  {
    let d: u8[] = [];
    for (let i: usize = 0; i < PNG_RGBA16_ADAM7.length; i++) {
      d.push(PNG_RGBA16_ADAM7[i]);
    }
    show("rgba16-adam7", d);
  }
  {
    let d: u8[] = [];
    for (let i: usize = 0; i < PNG_RGB8_BIG.length; i++) {
      d.push(PNG_RGB8_BIG[i]);
    }
    show("rgb8-big", d);
  }
  // 途中で切れた PNG と、PNG でないもの。
  let cut: u8[] = [];
  for (let i: usize = 0; i + 30 < PNG_RGBA8.length; i++) {
    cut.push(PNG_RGBA8[i]);
  }
  show("broken", cut);
  let text: u8[] = [72, 101, 108, 108, 111, 33, 33, 33, 33, 33];
  show("not png", text);
  return 0;
}
