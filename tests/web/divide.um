// 割り算と平方根を使うシェーダを、ブラウザの WebGPU で描く。WGSL の補助関数（um_fdiv / um_fsqrt）が NaN を
// 定数の bitcast で作っていたとき、Chrome（Tint）は「NaN は f32 で表せない」としてシェーダを拒み、何も描けなかった
// （wgpu-native では通るので、ネイティブのテストでは見つからなかった）。tests/run.ts が WebGPU あり（既定）で開く。
// expect: 4283782485
// expect: 4278190080

struct VOut {
  position: vec4<f32>;
}

vertex function vs(i: u32): VOut {
  // 画面全体を覆う三角形。
  const xs: f32[3] = [-1, 3, -1];
  const ys: f32[3] = [-1, -1, 3];
  return { position: vec4(xs[i % 3], ys[i % 3], 0.5, 1) };
}

fragment function fs(v: VOut, k: f32): vec4<f32> {
  // 1 / 3 と sqrt(1 / 9) はどちらも 0.333…（8 ビットにすると 85）。
  const third = 1 / k;
  return vec4(third, Math.sqrt(third * third), third, 1.0 as f32);
}

export function main(): i32 {
  let img = gpu.beginImage(8, 8, 0xFF000000);
  gpu.draw(mut img, 3, vs(), fs(3.0 as f32));
  let px = new Buffer<u32>(64);
  gpu.endImage(mut img, mut px);
  print(px[27]);
  // 描かない画像は埋めた色のまま。
  let empty = gpu.beginImage(2, 2, 0xFF000000);
  let px2 = new Buffer<u32>(4);
  gpu.endImage(mut empty, mut px2);
  print(px2[0]);
  return 0;
}
