// 標本の数がチャンネルの数の倍数でなければ停止する（フレームの途中で切れた標本は、左右がずれて鳴るため）。
// expect: open
// panic: invalid window call (unknown window, a size that is not positive, or a Buffer that is too short) (line 14)

export function main(): i32 {
  const opened = audioOpen(48000, 2);
  if (opened == null) {
    print("open");  // 音のデバイスがなくても、停止の確かめはできないので同じ出力にする
    return 0;
  }
  print("open");
  let buf = new Buffer<f32>(3);
  const s = opened;
  audioWrite(s, buf, 0, 3);
  return 0;
}
