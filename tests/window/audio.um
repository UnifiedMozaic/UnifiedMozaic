// 音の出力を、音のデバイスなしで確かめる。tests/run.ts が SDL_AUDIO_DRIVER=dummy で実行する
// （dummy のドライバも実際の時間の速さで標本を消費する）。
// expect: open
// expect: paused true
// expect: queued 4800
// expect: written 4800
// expect: played 0
// expect: still queued after pause ok
// expect: playing ok
// expect: clock moves ok
// expect: cleared 0
// expect: played kept ok
// expect: gain true
// expect: closed

function check(cond: bool, label: string): void {
  if (cond) {
    print(`${label} ok`);
  } else {
    print(`${label} bad`);
  }
}

export function main(): i32 {
  const opened = audioOpen(48000, 2);
  if (opened == null) {
    print(`no audio: ${windowError()}`);
    return 1;
  }
  const s = opened;
  print("open");
  print(`paused ${audioPaused(s)}`);

  // 0.1 秒の矩形波（ステレオ）を書く。開いた直後は一時停止なので、まだ鳴らない。
  let buf = new Buffer<f32>(9600);
  for (let i: u32 = 0; i < buf.length; i++) {
    buf[i] = ((i / 2) / 50) % 2 == 0 ? 0.25 : -0.25;
  }
  audioWrite(s, buf, 0, -1);
  print(`queued ${audioQueued(s)}`);
  print(`written ${audioWritten(s)}`);
  print(`played ${audioPlayed(s)}`);
  sleepMs(30);
  check(audioQueued(s) == 4800, "still queued after pause");

  // もう少し書き足してから鳴らす。
  for (let k = 0; k < 9; k++) {
    audioWrite(s, buf, 0, -1);
  }
  audioResume(s);
  sleepMs(200);
  check(!audioPaused(s) && audioQueued(s) < 48000, "playing");
  const p = audioPlayed(s);
  check(p > 0 && p + audioQueued(s) == audioWritten(s), "clock moves");

  audioPause(s);
  audioClear(s);
  print(`cleared ${audioQueued(s)}`);
  check(audioPlayed(s) >= p && audioWritten(s) == audioPlayed(s), "played kept");
  print(`gain ${audioSetGain(s, 0.5)}`);
  audioClose(s);
  print("closed");
  return 0;
}
