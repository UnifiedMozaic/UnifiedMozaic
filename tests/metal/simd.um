// simdgroup の集計（group.simdSum / simdMin / simdMax / simdShuffle / simdLane）。
// GPU（Metal の simd_sum など）と CPU（cpu.dispatchGroups）の結果が一致することを確かめる。
// グループの大きさが 32 で割り切れないとき（最後の simdgroup が短い）も確かめる。
// f32 の和は、値を整数にして丸めが出ないようにしてある（Metal の f32 の和は足す順番が決まっていない）。
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true

// 各スレッドに、自分の simdgroup の和・最小・最大と、lane を入れ替えた値を書く。
kernel function each(i: u32, out: mut RacyBuffer<i32>, xs: Buffer<i32>): void {
  const x = xs[i];
  const s = group.simdSum(x);
  const lo = group.simdMin(x);
  const hi = group.simdMax(x);
  // lane は 0〜39。32 以上（と、短い simdgroup の外）は最後のスレッドに切り詰める。
  const sh = group.simdShuffle(x, (group.local() * 7 + 3) % 40);
  out[i * 5] = s;
  out[i * 5 + 1] = lo;
  out[i * 5 + 2] = hi;
  out[i * 5 + 3] = sh;
  out[i * 5 + 4] = group.simdLane() as i32;
}

kernel function eachU(i: u32, out: mut RacyBuffer<u32>, xs: Buffer<u32>): void {
  const x = xs[i];
  const s = group.simdSum(x);
  const lo = group.simdMin(x);
  const hi = group.simdMax(x);
  out[i * 3] = s;
  out[i * 3 + 1] = lo;
  out[i * 3 + 2] = hi;
}

kernel function eachF(i: u32, out: mut RacyBuffer<f32>, xs: Buffer<f32>): void {
  const x = xs[i];
  const s = group.simdSum(x);
  const lo = group.simdMin(x);
  const hi = group.simdMax(x);
  const sh = group.simdShuffle(x, 0);
  out[i * 4] = s;
  out[i * 4 + 1] = lo;
  out[i * 4 + 2] = hi;
  out[i * 4 + 3] = sh;
}

// グループ全体の和: simdgroup ごとの和を共有配列に置き、もう一度 simdSum で足す（NNUE の内積の形）。
kernel function groupTotal(i: u32, out: mut RacyBuffer<i32>, xs: Buffer<i32>): void {
  let part: i32[32] = group.shared();
  const l = group.local();
  const s = group.simdSum(xs[i]);
  if (group.simdLane() == 0) {
    part[l / 32] = s;
  }
  group.barrier();
  let v: i32 = 0;
  if (l < (group.size() + 31) / 32) {
    v = part[l];
  }
  const total = group.simdSum(v);
  if (l == 0) {
    out[group.id()] = total;
  }
}

// 一様なループの中の集計（回るたびに値が変わる）。
kernel function rounds(i: u32, out: mut RacyBuffer<i32>, xs: Buffer<i32>, n: u32): void {
  let v = xs[i];
  for (let r: u32 = 0; r < n; r++) {
    const m = group.simdMax(v);
    v = m - v + (r as i32);
  }
  out[i] = v;
}

function sameI(a: RacyBuffer<i32>, b: RacyBuffer<i32>): bool {
  for (let k: u32 = 0; k < a.length; k++) {
    if (a[k] != b[k]) {
      return false;
    }
  }
  return true;
}

export function main(): i32 {
  const n: u32 = 64 * 48;
  let xs = new Buffer<i32>(n);
  let xu = new Buffer<u32>(n);
  let xf = new Buffer<f32>(n);
  for (let k: u32 = 0; k < n; k++) {
    xs[k] = (((k * 2654435761) >> 7) % 2001) as i32 - 1000;
    xu[k] = (k * 40503) ^ 0x9e3779b9;
    xf[k] = ((((k * 7919) % 401) as i32) - 200) as f32;
  }

  // 1. 大きさ 64・48・20（48 と 20 は最後の simdgroup が短い）。
  let ok1 = true;
  const sizes: u32[3] = [64, 48, 20];
  for (const size of sizes) {
    const groups = n / size;
    let g = new RacyBuffer<i32>(groups * size * 5);
    let c = new RacyBuffer<i32>(groups * size * 5);
    gpu.dispatchGroups(each, groups, size, mut g, xs);
    cpu.dispatchGroups(each, groups, size, mut c, xs);
    if (!sameI(g, c)) {
      ok1 = false;
    }
  }
  print(ok1);

  // 2. CPU の値を素直に求めた値と比べる（大きさ 48）。
  let c2 = new RacyBuffer<i32>(n * 5);
  cpu.dispatchGroups(each, n / 48, 48, mut c2, xs);
  let ok2 = true;
  for (let k: u32 = 0; k < n; k++) {
    const l = k % 48;
    const base = k - l + (l & 0xffffffe0);
    let cnt: u32 = 32;
    if (48 - (l & 0xffffffe0) < 32) {
      cnt = 48 - (l & 0xffffffe0);
    }
    let s: i32 = 0;
    for (let j: u32 = 0; j < cnt; j++) {
      s += xs[base + j];
    }
    let lane = (l * 7 + 3) % 40;
    if (lane >= cnt) {
      lane = cnt - 1;
    }
    if (c2[k * 5] != s || c2[k * 5 + 3] != xs[base + lane] || c2[k * 5 + 4] != ((l % 32) as i32)) {
      ok2 = false;
    }
  }
  print(ok2);

  // 3. u32（ラップする和、符号なしの最小・最大）。
  let gu = new RacyBuffer<u32>(n * 3);
  let cu = new RacyBuffer<u32>(n * 3);
  gpu.dispatchGroups(eachU, n / 64, 64, mut gu, xu);
  cpu.dispatchGroups(eachU, n / 64, 64, mut cu, xu);
  let ok3 = true;
  for (let k: u32 = 0; k < gu.length; k++) {
    if (gu[k] != cu[k]) {
      ok3 = false;
    }
  }
  print(ok3);

  // 4. f32。
  let gf = new RacyBuffer<f32>(n * 4);
  let cf = new RacyBuffer<f32>(n * 4);
  gpu.dispatchGroups(eachF, n / 64, 64, mut gf, xf);
  cpu.dispatchGroups(eachF, n / 64, 64, mut cf, xf);
  let ok4 = true;
  for (let k: u32 = 0; k < gf.length; k++) {
    if (gf[k] != cf[k]) {
      ok4 = false;
    }
  }
  print(ok4);

  // 5. グループ全体の和（大きさ 256 と 96）。
  let ok5 = true;
  const sizes5: u32[2] = [256, 96];
  for (const size of sizes5) {
    const groups = n / size;
    let g = new RacyBuffer<i32>(groups);
    let c = new RacyBuffer<i32>(groups);
    gpu.dispatchGroups(groupTotal, groups, size, mut g, xs);
    cpu.dispatchGroups(groupTotal, groups, size, mut c, xs);
    for (let q: u32 = 0; q < groups; q++) {
      let s: i32 = 0;
      for (let j: u32 = 0; j < size; j++) {
        s += xs[q * size + j];
      }
      if (g[q] != s || c[q] != s) {
        ok5 = false;
      }
    }
  }
  print(ok5);

  // 6. ループの中の集計。
  let g6 = new RacyBuffer<i32>(n);
  let c6 = new RacyBuffer<i32>(n);
  gpu.dispatchGroups(rounds, n / 64, 64, mut g6, xs, 6);
  cpu.dispatchGroups(rounds, n / 64, 64, mut c6, xs, 6);
  print(sameI(g6, c6));
  return 0;
}
