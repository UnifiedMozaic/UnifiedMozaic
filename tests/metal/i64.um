// 64 ビットの整数（i64 / u64）を使う kernel を CPU と GPU（Metal）で実行し、結果が一致することを確かめる。
// 出力は、GPU で計算した値をいくつか（決まった値）と、各 kernel の不一致の個数（0）。
// 81 マスの盤面を u64 2 つで持つビットボードの形の計算（32 ビットの境目をまたぐシフト、popcount、ctz で 1 を取り出すループ）を含む。
// wgpu-error: kernel-type
// expect: 81
// expect: 4294967296
// expect: 0
// expect: 0
// expect: 0
// expect: 0
// expect: 0
// expect: 0
// expect: 0

// 81 マスの盤。lo が 0〜62 マス、hi が 63〜80 マス（YaneuraOu の Bitboard と同じ分け方）。
struct Bb {
  lo: u64;
  hi: u64;
}

// u32 のあとに u64 が来る struct（8 バイト境界の詰め物が入る）。
struct Pos {
  tag: u32;
  bb: Bb;
  score: i64;
  marks: u64[3];
}

// 補助の kernel（u64 の引数と戻り値、struct の引数と戻り値）。
kernel function bbOr(a: Bb, b: Bb): Bb {
  return { lo: a.lo | b.lo, hi: a.hi | b.hi };
}

kernel function bbCount(b: Bb): u32 {
  return (Math.popcount(b.lo) + Math.popcount(b.hi)) as u32;
}

// 盤全体を 1 マス左へずらす（63 マス目が hi へ移る。32 ビットの境目もまたぐ）。
kernel function bbShift1(b: Bb): Bb {
  const carry = b.lo >> 62;
  return { lo: (b.lo << 1) & 0x7fffffffffffffff, hi: ((b.hi << 1) | carry) & 0x3ffff };
}

// 1 のマスを ctz で 1 つずつ取り出し、マス番号の重みつきの和を求める。
kernel function bbSum(b: Bb): u64 {
  let s: u64 = 0;
  let lo = b.lo;
  while (lo != 0) {
    const sq = Math.ctz(lo);
    s = s * 31 + sq + 1;
    lo = lo & (lo - 1);
  }
  let hi = b.hi;
  while (hi != 0) {
    const sq = Math.ctz(hi) + 63;
    s = s * 31 + sq + 1;
    hi = hi & (hi - 1);
  }
  return s;
}

kernel function boards(i: u32, out: mut Buffer<Pos>, src: Buffer<Bb>, salt: u32, mask: u64, bias: i64): void {
  const a = src[i];
  const b = src[(i + 1) % src.length];
  const u = bbShift1(bbOr(a, b));
  const n = bbCount(u);
  let p = out[i];
  p.tag = n + salt;
  p.bb = { lo: u.lo & mask, hi: u.hi };
  p.score = (bbSum(u) as i64) - bias * (n as i64);
  p.marks[0] = Math.clz(u.lo) + Math.clz(u.hi);
  p.marks[1] = Math.shl(u.lo, i) ^ Math.shr(u.hi, i + 1);
  p.marks[2] = (u.lo >> 31) ^ (u.hi << 33) ^ (u.lo << 32);
  out[i] = p;
}

kernel function arith(i: u32, out: mut Buffer<u64>, a: Buffer<u64>, b: Buffer<i64>): void {
  const x = a[i];
  const y = b[i];
  const s = x as i64;
  let r: u64 = x * 0x9e3779b97f4a7c15 + (x / ((i as u64) % 7)) + (x % ((i as u64) % 5));
  r = r ^ (x << (i as u64)) ^ (x >> ((i as u64) + 60));
  r = r + ((s / y) as u64) + ((s % y) as u64) + ((s >> (y & 127)) as u64) + ((s << y) as u64);
  r = r + (Math.abs(y) as u64) + (Math.min(s, y) as u64) * 3 + Math.max(x, 7) + Math.min(x, (1 as u64) << 40);
  r = r + Math.popcount(x) + Math.clz(x) + Math.ctz(x) + ((Math.popcount(y) + Math.clz(y) + Math.ctz(y)) as u64);
  r = r + (-x) + ((-y) as u64) + (~x) + ((~y) as u64);
  r = r + ((s < y) as u64) + ((x >= (1 as u64) << 63) as u64) * 2 + ((s == y) as u64) * 4;
  out[i] = r;
}

kernel function casts(i: u32, out: mut Buffer<i64>, a: Buffer<u64>, f: Buffer<f32>): void {
  const x = a[i];
  const v = f[i];
  let r: i64 = (v as i64) + ((v as u64) as i64) / 3 + ((x as i32) as i64) + ((x as u32) as i64);
  r = r + (((x as i64) as f32) as i64) / 5 + ((x as f32) as i64) / 7 + (((x >> 40) as f32) as i64);
  r = r + (((i as i32) - 5) as i64) + ((i as i64) - 5) + ((x != 0) as i64);
  // 64 ビットの添字（範囲外は最後の要素に切り詰める）。
  r = r + ((a[x] >> 1) as i64) + ((a[(i as i64) - 3] >> 2) as i64);
  out[i] = r;
}

kernel function racy(i: u32, out: mut RacyBuffer<u64>, a: Buffer<u64>): void {
  out[i] = a[i] * 3 + (out[i] >> 1);
}

function diffU64(a: Buffer<u64>, b: Buffer<u64>): u32 {
  let bad: u32 = 0;
  for (let i: u32 = 0; i < a.length; i++) {
    if (a[i] != b[i]) {
      bad += 1;
    }
  }
  return bad;
}

function diffI64(a: Buffer<i64>, b: Buffer<i64>): u32 {
  let bad: u32 = 0;
  for (let i: u32 = 0; i < a.length; i++) {
    if (a[i] != b[i]) {
      bad += 1;
    }
  }
  return bad;
}

class Rng {
  state: u64;

  constructor(seed: u64) {
    this.state = seed;
  }

  next(): u64 {
    this.state = this.state * 6364136223846793005 + 1442695040888963407;
    return this.state ^ (this.state >> 29);
  }
}

export function main(): i32 {
  const n: u32 = 5000;
  let rng = new Rng(12345);
  let ua = new Buffer<u64>(n);
  let ib = new Buffer<i64>(n);
  let fs = new Buffer<f32>(n);
  let src = new Buffer<Bb>(n);
  for (let i: u32 = 0; i < n; i++) {
    ua[i] = rng.next() >> (((i % 9) * 7) as u64);
    ib[i] = ((rng.next() as i64) >> (((i % 5) * 13) as i64)) - 20;
    fs[i] = ((rng.next() % 2000000) as f32) * 1.0e13 - 1.0e19;
    const bb: Bb = { lo: rng.next() & rng.next() & 0x7fffffffffffffff, hi: rng.next() & 0x3ffff };
    src[i] = bb;
  }
  // 端の値: ゼロ除算、最小値 / -1、範囲外の変換
  ua[1] = 0;
  ib[0] = -1;
  ib[1] = 0;
  ib[2] = -9223372036854775807 - 1;
  ib[3] = 64;
  fs[0] = 1.0e30;
  fs[1] = -1.0e30;
  fs[2] = 0;
  const full: Bb = { lo: 0x7fffffffffffffff, hi: 0x3ffff };
  src[0] = full;
  src[1] = full;

  // 盤の計算（struct の Buffer、u64 の値の引数の詰め物）
  let pa = new Buffer<Pos>(n);
  let pb = new Buffer<Pos>(n);
  cpu.dispatch(boards, n, mut pa, src, 7, 0xffffffff00000000, -3);
  gpu.dispatch(boards, n, mut pb, src, 7, 0xffffffff00000000, -3);
  print(pb[0].tag - 7 + 1);
  print(pb[0].bb.lo & ((1 as u64) << 32));
  let badPos: u32 = 0;
  for (let i: u32 = 0; i < n; i++) {
    const x = pa[i];
    const y = pb[i];
    if (x.tag != y.tag || x.bb.lo != y.bb.lo || x.bb.hi != y.bb.hi || x.score != y.score ||
        x.marks[0] != y.marks[0] || x.marks[1] != y.marks[1] || x.marks[2] != y.marks[2]) {
      badPos += 1;
    }
  }
  print(badPos);

  let a1 = new Buffer<u64>(n);
  let b1 = new Buffer<u64>(n);
  cpu.dispatch(arith, n, mut a1, ua, ib);
  gpu.dispatch(arith, n, mut b1, ua, ib);
  print(diffU64(a1, b1));

  let a2 = new Buffer<i64>(n);
  let b2 = new Buffer<i64>(n);
  cpu.dispatch(casts, n, mut a2, ua, fs);
  gpu.dispatch(casts, n, mut b2, ua, fs);
  print(diffI64(a2, b2));

  // RacyBuffer<u64>（各要素を書くのは 1 つの実行だけなので、結果は決まる）
  let ra = new RacyBuffer<u64>(n);
  let rb = new RacyBuffer<u64>(n);
  for (let i: u32 = 0; i < n; i++) {
    ra[i] = ua[i];
    rb[i] = ua[i];
  }
  cpu.dispatch(racy, n, mut ra, ua);
  gpu.dispatch(racy, n, mut rb, ua);
  let badRacy: u32 = 0;
  for (let i: u32 = 0; i < n; i++) {
    if (ra[i] != rb[i]) {
      badRacy += 1;
    }
  }
  print(badRacy);

  // gpu.submit（書く Buffer は RacyBuffer<u64>）
  let sa = new RacyBuffer<u64>(n);
  let sb = new RacyBuffer<u64>(n);
  cpu.dispatch(racy, n, mut sa, ua);
  const t = gpu.submit(racy, n, mut sb, ua);
  gpu.wait(t);
  let badSubmit: u32 = 0;
  for (let i: u32 = 0; i < n; i++) {
    if (sa[i] != sb[i]) {
      badSubmit += 1;
    }
  }
  print(badSubmit);

  // 自動の dispatch（CPU と GPU のどちらで実行されても同じ結果）
  let a3 = new Buffer<u64>(n);
  dispatch(arith, n, mut a3, ua, ib);
  print(diffU64(a1, a3));

  // 同じ kernel を何度も（常駐の経路に乗る並び）
  let bad4: u32 = 0;
  for (let round = 0; round < 12; round++) {
    let b4 = new Buffer<u64>(n);
    gpu.dispatch(arith, n, mut b4, ua, ib);
    bad4 += diffU64(a1, b4);
  }
  print(bad4);
  return 0;
}
