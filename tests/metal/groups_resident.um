// グループの dispatch（gpu.dispatchGroups / gpu.submitGroups）も常駐の経路（待機命令）に乗る。
// 同じ形を何度も呼んで待機を始めさせ、グループの数・引数・入力を毎回変えても、CPU（cpu.dispatchGroups）と
// 結果が同じになることを確かめる。乗ったかどうかは UM_GPU_TRACE=1（「resident started」）と
// UM_GPU_STATS=1（gpu.submit の「resident submits」）で見る（このテストの出力には出ない）。
// expect: 0
// expect: 0
// expect: 0
// expect: 0
// expect: 0
// expect: 0
// expect: 0

const SIZE: u32 = 64;

// グループごとの和を、グループの番号の場所に書く（書く場所の数はグループの数で、全体のスレッド数より少ない）。
kernel function groupSum(i: u32, out: mut RacyBuffer<i32>, xs: RacyBuffer<i32>, bias: i32): void {
  let t: i32[64] = group.shared();
  const l = group.local();
  t[l] = xs[i] * 3 + bias;
  group.barrier();
  for (let s = group.size() / 2; s > 0; s = s / 2) {
    if (l < s) {
      t[l] = t[l] + t[l + s];
    }
    group.barrier();
  }
  if (l == 0) {
    out[group.id()] = t[0] ^ (group.count() as i32);
  }
}

// スレッドごとに書く（グループの中で隣の値を見る）。普通の mut Buffer。
kernel function neighbor(i: u32, out: mut Buffer<i32>, xs: Buffer<i32>, k: i32): void {
  let t: i32[64] = group.shared();
  const l = group.local();
  t[l] = xs[i];
  group.barrier();
  out[i] = t[(l + 1) % group.size()] * k - t[l];
}

// 同じ形の、普通の（グループでない）kernel。並びに混ぜる。
kernel function bump(i: u32, out: mut RacyBuffer<i32>): void {
  out[i] = out[i] * 3 + (i as i32);
}

function fillR(xs: mut RacyBuffer<i32>, round: u32): void {
  for (let i: u32 = 0; i < xs.length; i++) {
    xs[i] = ((i * 2654435761 + round * 40503) >> 7) as i32 % 1000;
  }
}
function fillB(xs: mut Buffer<i32>, round: u32): void {
  for (let i: u32 = 0; i < xs.length; i++) {
    xs[i] = ((i * 2654435761 + round * 40503) >> 7) as i32 % 1000;
  }
}
function differR(a: RacyBuffer<i32>, b: RacyBuffer<i32>, n: u32): u32 {
  let bad: u32 = 0;
  for (let i: u32 = 0; i < n; i++) {
    if (a[i] != b[i]) {
      bad += 1;
    }
  }
  return bad;
}
function differB(a: Buffer<i32>, b: Buffer<i32>, n: u32): u32 {
  let bad: u32 = 0;
  for (let i: u32 = 0; i < n; i++) {
    if (a[i] != b[i]) {
      bad += 1;
    }
  }
  return bad;
}

export function main(): i32 {
  const maxGroups: u32 = 200;
  let xs = new RacyBuffer<i32>(maxGroups * SIZE);
  let g = new RacyBuffer<i32>(maxGroups);
  let c = new RacyBuffer<i32>(maxGroups);

  // 1. 同期の dispatchGroups を同じ形で 200 回。グループの数（1〜200）と引数・入力を毎回変える。
  let bad: u32 = 0;
  for (let round: u32 = 0; round < 200; round++) {
    fillR(mut xs, round);
    const n: u32 = (round * 37) % maxGroups + 1;
    gpu.dispatchGroups(groupSum, n, SIZE, mut g, xs, (round as i32) - 100);
    cpu.dispatchGroups(groupSum, n, SIZE, mut c, xs, (round as i32) - 100);
    bad += differR(g, c, n);
  }
  print(bad);

  // 2. スレッドごとに書く mut Buffer の kernel と、続けて書いた 2 つの dispatchGroups（1 つの形）。
  let xb = new Buffer<i32>(maxGroups * SIZE);
  let ob = new Buffer<i32>(maxGroups * SIZE);
  let cb = new Buffer<i32>(maxGroups * SIZE);
  let ob2 = new Buffer<i32>(maxGroups * SIZE);
  let cb2 = new Buffer<i32>(maxGroups * SIZE);
  bad = 0;
  for (let round: u32 = 0; round < 100; round++) {
    fillB(mut xb, round + 500);
    const n: u32 = (round * 13) % maxGroups + 1;
    gpu.dispatchGroups(neighbor, n, SIZE, mut ob, xb, (round as i32) % 7 - 3);
    gpu.dispatchGroups(neighbor, n, SIZE, mut ob2, ob, 2);
    cpu.dispatchGroups(neighbor, n, SIZE, mut cb, xb, (round as i32) % 7 - 3);
    cpu.dispatchGroups(neighbor, n, SIZE, mut cb2, cb, 2);
    bad += differB(ob2, cb2, n * SIZE);
  }
  print(bad);

  // 3. 出力の Buffer を作り直す（解放された領域を待機命令が使い続けないこと）。
  bad = 0;
  for (let round: u32 = 0; round < 30; round++) {
    let fresh = new RacyBuffer<i32>(maxGroups);
    for (let t: u32 = 0; t < 12; t++) {
      fillR(mut xs, round * 100 + t);
      gpu.dispatchGroups(groupSum, maxGroups, SIZE, mut fresh, xs, t as i32);
      cpu.dispatchGroups(groupSum, maxGroups, SIZE, mut c, xs, t as i32);
      bad += differR(fresh, c, maxGroups);
    }
  }
  print(bad);

  // 4. グループの数が 1 行（16384）を超える（格子が 2 行以上になる）。
  const bigGroups: u32 = 20000;
  let bx = new RacyBuffer<i32>(bigGroups * SIZE);
  let bg = new RacyBuffer<i32>(bigGroups);
  let bc = new RacyBuffer<i32>(bigGroups);
  bad = 0;
  for (let round: u32 = 0; round < 12; round++) {
    fillR(mut bx, round);
    const n: u32 = bigGroups - round * 997;
    gpu.dispatchGroups(groupSum, n, SIZE, mut bg, bx, 1);
    cpu.dispatchGroups(groupSum, n, SIZE, mut bc, bx, 1);
    bad += differR(bg, bc, n);
  }
  print(bad);

  // 5. gpu.submitGroups（検算なし・急ぎの列 = gpu.submit の常駐の対象）を同じ形で 200 回。
  bad = 0;
  const old = gpu.flags(3);
  for (let round: u32 = 0; round < 200; round++) {
    fillR(mut xs, round + 9000);
    const n: u32 = (round * 53) % maxGroups + 1;
    const t = gpu.submitGroups(groupSum, n, SIZE, mut g, xs, (round as i32) - 50);
    gpu.wait(t);
    cpu.dispatchGroups(groupSum, n, SIZE, mut c, xs, (round as i32) - 50);
    bad += differR(g, c, n);
  }
  print(bad);

  // 6. HOLD でつないだ並び: グループの submit と普通の submit（1 つの形）。
  bad = 0;
  for (let round: u32 = 0; round < 100; round++) {
    fillR(mut xs, round + 7000);
    const n: u32 = (round * 29) % maxGroups + 1;
    gpu.flags(7);
    gpu.submitGroups(groupSum, n, SIZE, mut g, xs, round as i32);
    gpu.flags(3);
    const t = gpu.submit(bump, n, mut g);
    gpu.wait(t);
    cpu.dispatchGroups(groupSum, n, SIZE, mut c, xs, round as i32);
    cpu.dispatch(bump, n, mut c);
    bad += differR(g, c, n);
  }
  print(bad);

  // 7. 待機中の形の Buffer を作り直す（submit の経路）。
  bad = 0;
  for (let round: u32 = 0; round < 20; round++) {
    let fresh = new RacyBuffer<i32>(maxGroups);
    for (let t: u32 = 0; t < 12; t++) {
      fillR(mut xs, round * 31 + t);
      const tk = gpu.submitGroups(groupSum, maxGroups, SIZE, mut fresh, xs, t as i32);
      gpu.wait(tk);
      cpu.dispatchGroups(groupSum, maxGroups, SIZE, mut c, xs, t as i32);
      bad += differR(fresh, c, maxGroups);
    }
  }
  gpu.flags(old);
  print(bad);
  return 0;
}
