// 文字の描画（drawText / textWidth）。小さな画像に描いて、点の形と位置を文字の絵で確かめる。
// 先に画像いっぱいの三角形（深度 0.5）を描いておき、文字（深度 0）が手前に重なることも確かめる。
// cpu-build
// fast-math
// expect: ..........................
// expect: .#...#...#.....#..........
// expect: .#...#.........#..........
// expect: .#...#..##.....#..........
// expect: .#####...#.....#..........
// expect: .#...#...#.....#..........
// expect: .#...#...#................
// expect: .#...#..###....#..........
// expect: ..........................
// expect: .R...R.R...R.GGGGG........
// expect: .R...R.RR.RR.....G........
// expect: .R...R.R.R.R....G.........
// expect: .R...R.R.R.R...G..........
// expect: .R...R.R...R..G...........
// expect: .R...R.R...R..G...........
// expect: ..RRR..R...R..G...........
// expect: ..........................
// expect: ..........................
// expect: 36
// expect: 12

import { drawText, textWidth } from "um:text";

struct VOut {
  position: vec4<f32>;
}

vertex function back(i: u32): VOut {
  const xs: f32[3] = [-1, 3, -1];
  const ys: f32[3] = [-1, -1, 3];
  return { position: vec4(xs[i % 3], ys[i % 3], 0.5, 1.0 as f32) };
}

fragment function blue(v: VOut): vec4<f32> {
  return vec4(0.0 as f32, 0, 1, 1);
}

export function main(): i32 {
  const w: u32 = 26;
  const h: u32 = 18;
  let img = gpu.beginImage(w as i32, h as i32, 0xFF000000);
  gpu.draw(mut img, 3, back(), blue());
  drawText(mut img, "Hi!", 1, 1, 1, 0xFFFFFFFF);
  drawText(mut img, "UM", 1, 9, 1, 0xFFFF0000);
  drawText(mut img, "7", 13, 9, 1, 0xFF00FF00);
  let px = new Buffer<u32>((w * h) as usize);
  gpu.endImage(mut img, mut px);
  for (let y: u32 = 0; y < h; y++) {
    let row = new Array<u8>(w as usize);
    for (let x: u32 = 0; x < w; x++) {
      const c = px[y * w + x];
      row[x] = c == 0xFFFFFFFF ? 35 : c == 0xFFFF0000 ? 82 : c == 0xFF00FF00 ? 71 : c == 0xFF0000FF ? 46 : 63;
    }
    print(stringFromBytes(row));
  }
  print(textWidth("Hi!", 2));
  print(textWidth("日本", 1));
  return 0;
}
