// 実行時に kernel を読み込む（gpu.loadKernel / gpu.runKernel）。MozaicCut のプラグインと同じ形:
// 入力と出力の Buffer<vec4<f32>>、u32 の w / h、f32[8] の引数。kernel の WGSL は `--emit-wgsl` が出すものと同じ
// （テストのランナーが `// wgsl:` の kernel の WGSL を、実行するフォルダに <名前>.wgsl として書く）。
// GPU で実行した結果が、同じ kernel を cpu.dispatch で実行した結果と一致することを確かめる。
// wgsl: fx
// wgsl: gain
// expect: true
// expect: 0
// expect: 0
// expect: true
// expect: false
// expect: false
// expect: false
// expect: 0

kernel function fx(i: u32, src: Buffer<vec4<f32>>, dst: mut Buffer<vec4<f32>>, w: u32, h: u32, args: f32[8]): void {
  const x = i % w;
  const y = i / w;
  // 右隣と下の画素との差（端は切り詰め）。割り算と平方根も CPU と同じに丸める。
  const c = src[i];
  const r = src[y * w + Math.min(x + 1, w - 1)];
  const d = src[Math.min(y + 1, h - 1) * w + x];
  const dx = r.x - c.x;
  const dy = d.y - c.y;
  const mag = Math.sqrt(dx * dx + dy * dy) / (args[1] + 1);
  dst[i] = vec4(c.x * args[0] + mag, c.y / (args[2] + 0.5), Math.floor(c.z * args[3]), c.w);
}

kernel function gain(i: u32, src: Buffer<vec4<f32>>, dst: mut Buffer<vec4<f32>>, w: u32, h: u32, args: f32[8]): void {
  const c = src[i];
  dst[i] = vec4(c.x * args[0], c.y * args[0], c.z * args[0], c.w);
}

function same(a: Buffer<vec4<f32>>, b: Buffer<vec4<f32>>): u32 {
  let bad: u32 = 0;
  for (let i: u32 = 0; i < a.length; i++) {
    if (a[i].x != b[i].x || a[i].y != b[i].y || a[i].z != b[i].z || a[i].w != b[i].w) {
      bad += 1;
    }
  }
  return bad;
}

function load(path: string): u32 | null {
  const bytes = readFile(path);
  if (bytes === null) {
    return null;
  }
  return gpu.loadKernel(stringFromBytes(bytes));
}

export function main(): i32 {
  const w: u32 = 320;
  const h: u32 = 180;
  const n = w * h;
  let src = new Buffer<vec4<f32>>(n);
  let seed: u32 = 99;
  for (let i: u32 = 0; i < n; i++) {
    seed = seed * 1664525 + 1013904223;
    const a = ((seed >> 8) % 1000) as f32;
    src[i] = vec4(a * 0.001, a * 0.37 - 20, a * 0.013, 1);
  }
  const args: f32[8] = [1.25, 0.5, 3, 7.5, 0, 0, 0, 0];

  const k = load("fx.wgsl");
  print(k !== null);
  if (k === null) {
    return 1;
  }
  let cpuOut = new Buffer<vec4<f32>>(n);
  let gpuOut = new Buffer<vec4<f32>>(n);
  cpu.dispatch(fx, n, src, mut cpuOut, w, h, args);
  const ran = gpu.runKernel(k, n, src, mut gpuOut, w, h, args);
  print(same(cpuOut, gpuOut));

  // 続けて実行する（前の出力を次の入力に）。途中では CPU に読み戻さない。
  const g = load("gain.wgsl");
  let a1 = new Buffer<vec4<f32>>(n);
  let a2 = new Buffer<vec4<f32>>(n);
  let c1 = new Buffer<vec4<f32>>(n);
  let c2 = new Buffer<vec4<f32>>(n);
  const half: f32[8] = [0.5, 0, 0, 0, 0, 0, 0, 0];
  let ok = ran && g !== null;
  if (g !== null) {
    ok = gpu.runKernel(g, n, src, mut a1, w, h, half) && ok;
    ok = gpu.runKernel(k, n, a1, mut a2, w, h, args) && ok;
    ok = gpu.runKernel(g, n, a2, mut a1, w, h, half) && ok;
  }
  cpu.dispatch(gain, n, src, mut c1, w, h, half);
  cpu.dispatch(fx, n, c1, mut c2, w, h, args);
  cpu.dispatch(gain, n, c2, mut c1, w, h, half);
  print(same(a1, c1));
  print(ok);

  // コンパイルできない WGSL は null。
  print(gpu.loadKernel("this is not WGSL") !== null);
  // 束縛の並びが kernel と合わない（Buffer が1つ足りない）と false。Buffer は変わらない。
  let untouched = new Buffer<vec4<f32>>(n);
  print(gpu.runKernel(k, n, mut untouched, w, h, args));
  // 書く Buffer に `mut` を付けないと false（kernel は read_write で宣言している）。
  print(gpu.runKernel(k, n, src, untouched, w, h, args));
  let zeros: u32 = 0;
  for (let i: u32 = 0; i < n; i++) {
    if (untouched[i].x != 0 || untouched[i].w != 0) {
      zeros += 1;
    }
  }
  print(zeros);
  return 0;
}
