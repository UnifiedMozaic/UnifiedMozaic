// 同じ場面を GPU と CPU のラスタライザで描き、画素を比べる。
//   - 透視投影の立方体（6 面、色は頂点ごとに違い、三角形の中で遠近を考えて補間する）
//   - カメラの近くを横切る大きな三角形（近い面で切られる）
// GPU は頂点の位置を画素の細かい格子（ふつう 1/256 画素）に丸めるので、辺のすぐ近くの画素だけは結果が分かれうる
// （塗るかどうか、2 つの面が接する辺ならどちらの面の色か。lavapipe では一致し、SwiftShader では数画素が分かれた）。
// 出力: 塗るかどうかが分かれた画素が全体の 1% 未満か、両方が塗って色が 3 / 255 より違う画素が 0.5% 未満か、
//       塗られた画素の数が近いか。
// cpu-build
// fast-math
// expect: true
// expect: true
// expect: true

struct Vertex {
  pos: vec3<f32>;
  color: vec3<f32>;
}

struct VOut {
  position: vec4<f32>;
  color: vec3<f32>;
}

vertex function vs(i: u32, verts: Buffer<Vertex>, mvp: mat4<f32>): VOut {
  const v = verts[i];
  const p: vec4<f32> = vec4(v.pos.x, v.pos.y, v.pos.z, 1);
  return { position: mat4MulVec(mvp, p), color: v.color };
}

fragment function fs(v: VOut): vec4<f32> {
  return vec4(v.color.x, v.color.y, v.color.z, 1);
}

function corner(k: u32): vec3<f32> {
  const x: f32 = (k & 1) != 0 ? 1 : -1;
  const y: f32 = (k & 2) != 0 ? 1 : -1;
  const z: f32 = (k & 4) != 0 ? 1 : -1;
  return vec3(x, y, z);
}

function shade(k: u32): vec3<f32> {
  const c = corner(k);
  return vec3(c.x * 0.5 + 0.5, c.y * 0.5 + 0.5, c.z * 0.5 + 0.5);
}

function channelDiff(a: u32, b: u32, shift: u32): u32 {
  const x = (a >> shift) & 255;
  const y = (b >> shift) & 255;
  return x > y ? x - y : y - x;
}

export function main(): i32 {
  // 立方体の 6 面 × 2 三角形 + 近い面を横切る三角形 1 つ
  const faces: u32[24] = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3];
  let verts = new Buffer<Vertex>(39);
  let n: u32 = 0;
  for (let f: u32 = 0; f < 6; f++) {
    const q: u32[4] = [faces[f * 4], faces[f * 4 + 1], faces[f * 4 + 2], faces[f * 4 + 3]];
    const tri: u32[6] = [q[0], q[1], q[2], q[0], q[2], q[3]];
    for (let k: u32 = 0; k < 6; k++) {
      verts[n] = { pos: corner(tri[k]), color: shade(tri[k]) };
      n++;
    }
  }
  verts[36] = { pos: vec3(-3.0 as f32, -0.9, 3.5), color: vec3(1.0 as f32, 0, 1) };
  verts[37] = { pos: vec3(3.0 as f32, -0.9, 3.5), color: vec3(0.0 as f32, 1, 1) };
  verts[38] = { pos: vec3(0.0 as f32, -0.9, -6), color: vec3(1.0 as f32, 1, 0) };

  const w: i32 = 160;
  const h: i32 = 120;
  const model = mat4Mul(mat4RotateY(0.6), mat4RotateX(0.4));
  const view = mat4LookAt(vec3(0.0 as f32, 0.5, 4), vec3(0.0 as f32, 0, 0), vec3(0.0 as f32, 1, 0));
  const proj = mat4Perspective(Math.PI / 3, (w as f32) / (h as f32), 0.5, 50);
  const mvp = mat4Mul(proj, mat4Mul(view, model));

  let g = gpu.beginImage(w, h, 0xFF000000);
  gpu.draw(mut g, 39, vs(verts, mvp), fs());
  let c = new GpuImage(w, h, 0, 0xFF000000);
  gpu.draw(mut c, 39, vs(verts, mvp), fs());
  let gp = new Buffer<u32>((w * h) as usize);
  let cp = new Buffer<u32>((w * h) as usize);
  gpu.endImage(mut g, mut gp);
  gpu.endImage(mut c, mut cp);

  let split: u32 = 0;
  let worst: u32 = 0;
  let differ: u32 = 0;
  let gn: u32 = 0;
  let cn: u32 = 0;
  for (let i: u32 = 0; i < (w * h) as u32; i++) {
    const a = gp[i];
    const b = cp[i];
    if (a != 0xFF000000) {
      gn++;
    }
    if (b != 0xFF000000) {
      cn++;
    }
    if ((a == 0xFF000000) != (b == 0xFF000000)) {
      split++;
    } else {
      const d = Math.max(channelDiff(a, b, 16), Math.max(channelDiff(a, b, 8), channelDiff(a, b, 0)));
      worst = Math.max(worst, d);
      if (d > 3) {
        differ++;
      }
    }
  }
  print(split * 100 < (w * h) as u32);
  print(differ * 200 < gn);
  print(gn > 3000 && (gn > cn ? gn - cn : cn - gn) * 100 < gn);
  eprint(`split ${split}, differ ${differ}, worst ${worst}, painted gpu ${gn} cpu ${cn}`);
  return 0;
}
