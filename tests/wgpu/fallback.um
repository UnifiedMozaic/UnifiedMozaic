// wgpu の経路で、WGSL にできない kernel は CPU で実行される（docs/wgpu.ja.md「CPU で実行する kernel」）。
//   64 ビットの整数を使う kernel: dispatch と gpu.submit は CPU で実行する（gpu.dispatch はコンパイルエラー）。
//   simdgroup の集計を使う kernel: dispatchGroups は CPU で実行する（gpu.dispatchGroups はコンパイルエラー）。
// どちらも結果は cpu.dispatch と同じ。同じプログラムのほかの kernel は GPU で実行する。
// expect: 0
// expect: 0
// expect: 0
// expect: true
// expect: 0

kernel function wide(i: u32, out: mut Buffer<u64>, xs: Buffer<u32>): void {
  const x = xs[i] as u64;
  out[i] = (x << 33) ^ (x * 2654435761);
}

kernel function wideR(i: u32, out: mut RacyBuffer<u64>, xs: Buffer<u32>): void {
  const x = xs[i] as u64;
  out[i] = (x << 33) ^ (x * 2654435761);
}

kernel function lanes(i: u32, out: mut Buffer<i32>, xs: Buffer<i32>): void {
  const s = group.simdSum(xs[i]);
  out[i] = s + (group.local() as i32);
}

kernel function narrow(i: u32, out: mut Buffer<u32>, xs: Buffer<u32>): void {
  out[i] = xs[i] * 3 + 1;
}

export function main(): i32 {
  const n: u32 = 100000;
  let xs = new Buffer<u32>(n);
  let ys = new Buffer<i32>(n);
  for (let i: u32 = 0; i < n; i++) {
    xs[i] = i * 2654435761;
    ys[i] = ((i % 1000) as i32) - 500;
  }

  let a = new Buffer<u64>(n);
  let b = new Buffer<u64>(n);
  for (let k = 0; k < 5; k++) {
    dispatch(wide, n, mut a, xs);
  }
  cpu.dispatch(wide, n, mut b, xs);
  let bad: u32 = 0;
  for (let i: u32 = 0; i < n; i++) {
    if (a[i] != b[i]) {
      bad += 1;
    }
  }
  print(bad);

  // gpu.submit も CPU で実行して、券 0（もう終わっている）を返す。
  let c = new RacyBuffer<u64>(n);
  const t = gpu.submit(wideR, n, mut c, xs);
  gpu.wait(t);
  bad = 0;
  for (let i: u32 = 0; i < n; i++) {
    if (c[i] != b[i]) {
      bad += 1;
    }
  }
  print(bad);

  let l1 = new Buffer<i32>(64 * 100);
  let l2 = new Buffer<i32>(64 * 100);
  dispatchGroups(lanes, 100, 64, mut l1, ys);
  cpu.dispatchGroups(lanes, 100, 64, mut l2, ys);
  bad = 0;
  for (let i: u32 = 0; i < 6400; i++) {
    if (l1[i] != l2[i]) {
      bad += 1;
    }
  }
  print(bad);
  print(t == 0);

  let g = new Buffer<u32>(n);
  gpu.dispatch(narrow, n, mut g, xs);
  bad = 0;
  for (let i: u32 = 0; i < n; i++) {
    if (g[i] != xs[i] * 3 + 1) {
      bad += 1;
    }
  }
  print(bad);
  return 0;
}
