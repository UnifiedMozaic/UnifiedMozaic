// RacyBuffer を fill で書いているあいだ、ほかのスレッドが読む。見える値は前の値か新しい値だけ（ちぎれない）。
// 大きい（16 MiB 以上）ので fill は複数のスレッドで書く。
// expect: 0
// expect: 1

function reader(b: RacyBuffer<u64>, stop: RacyBuffer<u32>): i32 {
  let bad = 0;
  let i: u32 = 0;
  while (stop.load(0) == 0) {
    const v = b[i];
    if (v != 0x1111111111111111 && v != 0x2222222222222222 && v != 0) { bad++; }
    i = (i + 4099) % (b.length as u32);
  }
  return bad;
}

export function main(): i32 {
  let b = new RacyBuffer<u64>(1 << 22);   // 32 MiB
  b.fill(0x1111111111111111);
  let stop = new RacyBuffer<u32>(1);
  let bad = 0;
  {
    const r = thread.spawn(reader, b, stop);
    for (let k = 0; k < 6; k++) {
      b.fill(k % 2 == 0 ? 0x2222222222222222 : 0x1111111111111111);
      b.fill(0, 100, 200);
    }
    stop.store(0, 1);
    bad = thread.join(r);
  }
  print(bad);
  print(b[150] == 0 && b[99] == 0x1111111111111111 ? 1 : 0);
  return 0;
}
