// 8 スレッドが長い行を print する。1回の print（1行）はほかのスレッドの出力と混ざらない。
// sorted
// 出力は並べ替えてから比べる（スレッドの順番は決まらない）。
function talk(k: u32, line: string): u32 {
  for (let i = 0; i < 3; i++) {
    print(`${k}:${line}`);
  }
  return k;
}

export function main(): i32 {
  let line = "";
  for (let i = 0; i < 200; i++) {
    line = line + "abcdefghij";
  }
  let ks: u32[] = [0, 1, 2, 3, 4, 5, 6, 7];
  const g = thread.spawnEach(talk, own ks, line);
  thread.join(g);
  return 0;
}

