// 止める合図が立つまで回るループ（Lazy SMP の補助スレッドの形）。kernel の外の RacyBuffer の読み書きは
// monotonic なので、最適化してもループの中で毎回読み直され、必ず止まる（unordered だとループの外へ出されうる）。
function spin(k: u32, stop: RacyBuffer<u32>, counts: RacyBuffer<u64>): u32 {
  let n: u64 = 0;
  while (stop[0] == 0) {
    n = n + 1;
  }
  counts[k] = n;
  return k;
}

export function main(): i32 {
  const stop = new RacyBuffer<u32>(1);
  const counts = new RacyBuffer<u64>(4);
  let ks: u32[] = [0, 1, 2, 3];
  {
    const g = thread.spawnEach(spin, own ks, stop, counts);
    // 補助スレッドが回り始めるまで少し待ってから合図を立てる。
    const t0 = clock();
    while (clock() - t0 < 0.02) {
    }
    stop[0] = 1;
    const back = thread.join(g);
    print(back.length);
  }
  print(counts[0] + counts[1] + counts[2] + counts[3] > 0);
  return 0;
}

// expect: 4
// expect: true
