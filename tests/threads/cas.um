// 16 スレッドが compareExchange で同じ数を増やす。合計は正確。
function inc(k: u32, total: RacyBuffer<u64>, n: u32): u32 {
  let retries: u32 = 0;
  for (let i: u32 = 0; i < n; i++) {
    let old = total.load(0);
    while (total.compareExchange(0, old, old + 1) != old) {
      old = total.load(0);
      retries++;
    }
  }
  return k;
}

export function main(): i32 {
  const total = new RacyBuffer<u64>(1);
  let ks: u32[] = [];
  for (let k: u32 = 0; k < 16; k++) {
    ks.push(k);
  }
  {
    const g = thread.spawnEach(inc, own ks, total, 20000);
    const back = thread.join(g);
    let sum: u32 = 0;
    for (const b of back) {
      sum += b;
    }
    print(sum);
  }
  print(total[0]);
  return 0;
}

// expect: 120
// expect: 320000
