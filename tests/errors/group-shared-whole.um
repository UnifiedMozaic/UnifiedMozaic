// 共有配列は添字で1要素ずつ読み書きする。配列ごと写すことはできない。
kernel function k(i: u32, out: mut Buffer<u32>): void {
  let t: u32[32] = group.shared();
  t[group.local()] = i;
  group.barrier();
  const copy = t;
  out[i] = copy[0];
}

export function main(): i32 {
  let b = new Buffer<u32>(64);
  dispatchGroups(k, 2, 32, mut b);
  return 0;
}

