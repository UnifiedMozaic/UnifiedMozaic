// error: webgpu-const-array
// 定数の配列を使う kernel は WebGPU（WGSL）にしない。wasm32 で gpu.dispatch を書くとエラー（dispatch なら CPU で実行する）。
const T: u32[3] = [1, 2, 3];
kernel function k(i: u32, out: mut Buffer<u32>): void {
  out[i] = T[i];
}
export function main(): i32 {
  let out = new Buffer<u32>(3);
  gpu.dispatch(k, 3, mut out);
  return 0;
}
