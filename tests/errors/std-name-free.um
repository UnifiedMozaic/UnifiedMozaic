// 標準の中だけで使っていた名前（以前の renderPack など）は、プログラムが自由に使える。描画もそのまま動く。
// error: type-mismatch
function renderPack(x: i32): i32 {
  return x;
}

export function main(): i32 {
  let img = gpu.beginImage(2, 2, 0);
  let px = new Buffer<u32>(4);
  gpu.endImage(mut img, mut px);
  const s: string = renderPack(1);
  return 0;
}
