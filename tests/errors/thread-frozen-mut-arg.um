// 貸した変数を mut で渡せない。
function grow(xs: mut i32[]): void {
  xs.push(1);
}

function f(x: i32): i32 {
  return x;
}

function g(xs: i32[]): i32 {
  return xs[0];
}

export function main(): i32 {
  let xs: i32[] = [1];
  const h = thread.spawn(g, xs);
  grow(mut xs);
  return 0;
}

// error: exclusive-borrow
