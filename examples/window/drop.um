// ファイルのドロップ。ウィンドウにファイルやフォルダを落とすと、パスと落とした位置が表示される。
// ドラッグ中は、落とす位置にある枠（左: 素材の箱、右: タイムライン）が明るくなる。Esc で終わる。
// ネイティブだけ（SDL3 が必要。docs/window.ja.md）。
//   node src/cli.ts build examples/window/drop.um --target host -o drop && ./drop
// 引数に test を渡すと、試験用の操作でドロップのイベントを積んで、届いたものを表示して終わる。
// args: test
// expect: drop begin
// expect: bin: C:\素材\clip 01.mp4 (10, 20)
// expect: bin: C:\素材\音楽 (10, 20)
// expect: dropped 2 item(s)

const WIDTH: i32 = 640;
const HEIGHT: i32 = 360;

// 落とす先: 0 素材の箱（左 1/3）、1 タイムライン（右 2/3）。ドラッグ中でなければ -1。
function zoneAt(x: i32): i32 {
  return x < WIDTH / 3 ? 0 : 1;
}

kernel function draw(i: u32, px: mut Buffer<u32>, zone: i32, flash: u32): void {
  const x = (i % 640) as i32;
  const y = (i / 640) as i32;
  let c: u32 = 0xFF1C1F24;
  const inBin = x >= 12 && x < 201 && y >= 12 && y < 348;
  const inTimeline = x >= 225 && x < 628 && y >= 12 && y < 348;
  if (inBin) {
    c = zone == 0 ? 0xFF3D5A80 : 0xFF2A2F36;
  }
  if (inTimeline) {
    c = zone == 1 ? 0xFF3D5A80 : 0xFF2A2F36;
  }
  if ((inBin || inTimeline) && flash > 0) {
    c = c + 0x00101010 * (flash / 4);
  }
  px[i] = c;
}

export function main(): i32 {
  const opened = windowOpen("ここにファイルを落とす", WIDTH, HEIGHT);
  if (opened == null) {
    eprint(`could not open a window: ${windowError()}`);
    return 1;
  }
  const win = opened;
  const a = args();
  const test = a.length > 0 && a[0] == "test";
  if (test) {
    // 人の操作の代わりに、試験用の操作（windowSetText の 90 番）で SDL のイベントを積む。
    windowSetText(90, win, 11, "");
    windowSetText(90, win, 12, "C:\\素材\\clip 01.mp4");
    windowSetText(90, win, 12, "C:\\素材\\音楽");
    windowSetText(90, win, 15, "");
  }

  let px = new Buffer<u32>((WIDTH * HEIGHT) as usize);
  let zone: i32 = -1;
  let flash: u32 = 0;
  let count = 0;
  let running = true;
  while (running) {
    while (true) {
      const e = pollWindowEvent(test ? 100 : 0);
      if (e == null) {
        if (test) {
          running = false;  // 積んだイベントを読み終えた
        }
        break;
      }
      match (e) {
        WindowEvent.Close(w) => { running = false; }
        WindowEvent.Quit => { running = false; }
        WindowEvent.KeyDown(w, key, mods, repeat) => {
          match (key) {
            Key.Escape => { running = false; }
            _ => {}
          }
        }
        WindowEvent.DropBegin(w) => {
          print("drop begin");
          count = 0;
        }
        WindowEvent.DropPosition(w, x, y) => {
          zone = zoneAt(x);
        }
        WindowEvent.DropFile(w, path, x, y) => {
          if (zoneAt(x) == 0) {
            print(`bin: ${path} (${x}, ${y})`);
          } else {
            print(`timeline: ${path} (${x}, ${y})`);
          }
          count++;
        }
        WindowEvent.DropText(w, text, x, y) => {
          print(`text: ${text}`);
        }
        WindowEvent.DropComplete(w, x, y) => {
          print(`dropped ${count} item(s)`);
          zone = -1;
          flash = 60;
        }
        _ => {}
      }
    }
    dispatch(draw, px.length as u32, mut px, zone, flash);
    windowPresent(win, px, WIDTH, HEIGHT);
    if (flash > 0) {
      flash--;
    }
  }
  windowClose(win);
  return 0;
}
