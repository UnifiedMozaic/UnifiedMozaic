// 回る立方体をウィンドウに出す。シェーダ（vertex function / fragment function）で描き、深度テストで奥の面を隠す。
// GPU が使えれば GPU で（UM_WGPU=1 のビルド）、使えなければ CPU で同じ絵を描く（docs/render.ja.md）。
// Esc か閉じるボタンで終わる。Space で止める。ネイティブだけ（SDL3 が必要。docs/window.ja.md）。
//   UM_WGPU=1 node src/cli.ts build examples/window/cube.um --target host -o cube && ./cube   （GPU で描く）
//   node src/cli.ts build examples/window/cube.um --target host -o cube && ./cube             （CPU で描く）
// 引数に数を渡すと、そのフレーム数だけ描いて終わる（テスト用）。

struct Vertex {
  pos: vec3<f32>;
  normal: vec3<f32>;
  color: vec3<f32>;
}

struct Camera {
  mvp: mat4<f32>;    // 頂点をクリップ空間へ
  model: mat4<f32>;  // 法線を回す
}

struct VOut {
  position: vec4<f32>;
  normal: vec3<f32>;
  color: vec3<f32>;
}

vertex function vs(i: u32, verts: Buffer<Vertex>, cam: Camera): VOut {
  const v = verts[i];
  const p: vec4<f32> = vec4(v.pos.x, v.pos.y, v.pos.z, 1);
  const n: vec4<f32> = vec4(v.normal.x, v.normal.y, v.normal.z, 0);
  const r = mat4MulVec(cam.model, n);
  return { position: mat4MulVec(cam.mvp, p), normal: vec3(r.x, r.y, r.z), color: v.color };
}

// 光の向きとの内積で明るさを決める（少しの環境光を足す）。
fragment function fs(v: VOut, light: vec3<f32>): vec4<f32> {
  const d = Math.max(vec3Dot(vec3Normalize(v.normal), light), 0) * 0.8 + 0.2;
  return vec4(v.color.x * d, v.color.y * d, v.color.z * d, 1);
}

// 立方体の 36 頂点（6 面 × 2 三角形）。面ごとに色と法線が一つ。
function cubeVertices(): Buffer<Vertex> {
  const colors: vec3<f32>[6] = [vec3(0.9 as f32, 0.3, 0.3), vec3(0.3 as f32, 0.9, 0.4), vec3(0.3 as f32, 0.5, 0.95),
    vec3(0.95 as f32, 0.85, 0.3), vec3(0.8 as f32, 0.4, 0.9), vec3(0.3 as f32, 0.85, 0.9)];
  const us: f32[6] = [-1, 1, 1, -1, 1, -1];
  const ws: f32[6] = [-1, -1, 1, -1, 1, 1];
  let verts = new Buffer<Vertex>(36);
  let n: u32 = 0;
  for (let axis: u32 = 0; axis < 3; axis++) {
    for (let side: u32 = 0; side < 2; side++) {
      const s: f32 = side == 0 ? -1 : 1;
      for (let k: u32 = 0; k < 6; k++) {
        let p: vec3<f32> = vec3(s, us[k], ws[k]);
        let nrm: vec3<f32> = vec3(s, 0, 0);
        if (axis == 1) {
          p = vec3(us[k], s, ws[k]);
          nrm = vec3(0, s, 0);
        } else if (axis == 2) {
          p = vec3(us[k], ws[k], s);
          nrm = vec3(0, 0, s);
        }
        verts[n] = { pos: p, normal: nrm, color: colors[axis * 2 + side] };
        n++;
      }
    }
  }
  return verts;
}

export function main(): i32 {
  const opened = windowOpen("cube", 640, 480);
  if (opened == null) {
    eprint("could not open a window");
    return 1;
  }
  const win = opened;
  let limit: i32 = -1;
  const a = args();
  if (a.length > 0) {
    limit = 0;
    for (const c of a[0]) {
      limit = limit * 10 + ((c as i32) - 48);
    }
  }

  const verts = cubeVertices();
  const light = vec3Normalize(vec3(0.4 as f32, 0.8, 1));
  const start = ticksNs();
  let paused = false;
  let angle: f32 = 0;
  let frames: i32 = 0;
  let running = true;
  while (running) {
    while (true) {
      const e = pollWindowEvent(0);
      if (e == null) {
        break;
      }
      match (e) {
        WindowEvent.Close(w) => {
          running = false;
        }
        WindowEvent.Quit => {
          running = false;
        }
        WindowEvent.KeyDown(w, key, mods, repeat) => {
          match (key) {
            Key.Escape => { running = false; }
            Key.Space => { paused = !paused; }
            _ => {}
          }
        }
        _ => {}
      }
    }
    if (!paused) {
      // 1 秒に 1 ラジアンほど回す。角度は 2π の中に保つ（三角関数の誤差が小さい範囲）。
      angle = ((ticksNs() - start) as f64 / 1.0e9 % (2 * Math.PI)) as f32;
    }
    let frame = gpu.beginFrame(win, 0xFF202028);
    // 縦横比はフレーム（ウィンドウの画素）の大きさから。大きさを変えても歪まない。
    const aspect = (frame.width as f32) / Math.max(frame.height as f32, 1);
    const model = mat4Mul(mat4RotateY(angle), mat4RotateX(angle * 0.6));
    const view = mat4LookAt(vec3(0.0 as f32, 0, 5), vec3(0.0 as f32, 0, 0), vec3(0.0 as f32, 1, 0));
    const proj = mat4Perspective(Math.PI / 3, aspect, 0.5, 50);
    const cam: Camera = { mvp: mat4Mul(proj, mat4Mul(view, model)), model: model };
    gpu.draw(mut frame, 36, vs(verts, cam), fs(light));
    gpu.endFrame(mut frame);
    frames++;
    if (limit >= 0 && frames >= limit) {
      running = false;
    }
  }
  windowClose(win);
  print(frames);
  return 0;
}
