// 映像と音を作って MP4（H.264 と AAC）に書き、読み直して確かめる。
// 使い方: write_mp4 [出力] [符号器]（省略すると out.mp4 に "h264"。"h264" は使える中から
//         ハードウェア（NVENC → AMF → QSV → VideoToolbox → MediaFoundation）、ソフトウェア（OpenH264）の順に選ぶ）
//
// expect: wrote 60 frames and 2 s of audio
// expect: read back: h264 320x240, 30/1 fps, 60 frames, aac 48000 Hz 2 channels
// expect: frame at 1.5 s has the number 45

import { MediaPixels, MediaRead, MediaVideoSettings, MediaAudioSettings, mediaOpenVideo, mediaProbe, mediaFrame, mediaCreate, mediaAddVideoStream, mediaAddAudioStream, mediaWriteFrame, mediaWriteSamples, mediaFinish, mediaClose } from "um:media";


// sin(2π x)。x の整数部を捨てて [-0.5, 0.5) の周期に寄せ、テイラー展開で求める（UM にはまだ Math.sin がない）。
function sine(x: f64): f64 {
  let f = x - Math.floor(x);
  if (f >= 0.5) {
    f = f - 1.0;
  }
  const a = 2.0 * 3.141592653589793 * f;
  const a2 = a * a;
  let term = a;
  let sum = a;
  for (let k = 1; k < 12; k++) {
    term = 0.0 - term * a2 / (((2 * k) * (2 * k + 1)) as f64);
    sum += term;
  }
  return sum;
}

export function main(): i32 {
  let path = "out.mp4";
  let encoder = "h264";
  const a = args();
  if (a.length > 0) {
    path = a[0].clone();
  }
  if (a.length > 1) {
    encoder = a[1].clone();
  }
  const w = 320;
  const h = 240;
  const fps = 30;
  const frames = 60;
  const rate = 48000;

  let writer: i64 = 0;
  match (mediaCreate(path)) {
    Result.Ok(x) => { writer = x; }
    Result.Err(why) => {
      eprint("cannot create: " + why);
      return 1;
    }
  }
  let v = new MediaVideoSettings();
  v.encoder = encoder;
  v.width = w;
  v.height = h;
  v.fpsNum = fps;
  v.bitRate = 2000000;
  match (mediaAddVideoStream(writer, v)) {
    Result.Ok(name) => { eprint("video encoder: " + name); }
    Result.Err(why) => {
      eprint("cannot add the video stream: " + why);
      mediaFinish(writer);
      return 1;
    }
  }
  match (mediaAddAudioStream(writer, new MediaAudioSettings())) {  // AAC、48 kHz、ステレオ
    Result.Ok(name) => { eprint("audio encoder: " + name); }
    Result.Err(why) => {
      eprint("cannot add the audio stream: " + why);
      mediaFinish(writer);
      return 1;
    }
  }

  // コマ: 色にコマの番号を入れ（R = (N mod 16) * 16 + 8、G = floor(N / 16) * 16 + 8）、白い四角を動かす。
  // 音: 1 コマ分（48000 / 30 = 1600 標本）ずつ、左は 440 Hz、右は 660 Hz。映像と音を交互に書く。
  let px = new Buffer<u32>(w * h);
  const per = rate / fps;
  let samples = new Buffer<f32>(per * 2);
  for (let n = 0; n < frames; n++) {
    const red = ((n % 16) * 16 + 8) as u32;
    const green = ((n / 16) * 16 + 8) as u32;
    const bg: u32 = 0xFF000080 | (red << 16) | (green << 8);
    px.fill(bg);
    const x0 = n * 4;
    for (let y = 100; y < 140; y++) {
      for (let x = x0; x < x0 + 40; x++) {
        px[y * w + x] = 0xFFFFFFFF;
      }
    }
    const err = mediaWriteFrame(writer, px, MediaPixels.Argb32, w, h);
    if (err != null) {
      eprint("cannot write a frame: " + err);
      mediaFinish(writer);
      return 1;
    }
    for (let k = 0; k < per; k++) {
      const t = ((n * per + k) as f64) / (rate as f64);
      samples[k * 2] = (0.25 * sine(440.0 * t)) as f32;
      samples[k * 2 + 1] = (0.25 * sine(660.0 * t)) as f32;
    }
    const aerr = mediaWriteSamples(writer, samples, -1);
    if (aerr != null) {
      eprint("cannot write audio: " + aerr);
      mediaFinish(writer);
      return 1;
    }
  }
  const done = mediaFinish(writer);
  if (done != null) {
    eprint("cannot finish: " + done);
    return 1;
  }
  print(`wrote ${frames} frames and ${frames / fps} s of audio`);

  // 読み直す。
  match (mediaProbe(path)) {
    Result.Ok(i) => {
      print(`read back: ${i.videoCodec} ${i.width}x${i.height}, ${i.fpsNum}/${i.fpsDen} fps, ${i.frameCount} frames, ${i.audioCodec} ${i.sampleRate} Hz ${i.channels} channels`);
    }
    Result.Err(why) => {
      eprint("cannot read back: " + why);
      return 1;
    }
  }
  match (mediaOpenVideo(path, "none")) {
    Result.Ok(r) => {
      let back = new Buffer<u8>(w * h * 4);
      match (mediaFrame(r, 1.5, mut back, MediaPixels.Rgba8, 0, 0)) {
        MediaRead.Frame(t) => {
          const at = (20 * w + 20) * 4;  // 左上の背景
          print(`frame at ${t} s has the number ${(back[at] as i32) / 16 + (back[at + 1] as i32) / 16 * 16}`);
        }
        MediaRead.End => { print("no frame at 1.5 s"); }
        MediaRead.Failed(why) => { print("cannot read: " + why); }
      }
      mediaClose(r);
    }
    Result.Err(why) => {
      eprint("cannot open: " + why);
      return 1;
    }
  }
  return 0;
}
