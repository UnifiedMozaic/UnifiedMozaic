// ウィンドウと音の標準の型と関数。組み込みの windowPoll / windowCtl / windowSetText / windowGetText / audioWrite
// （runtime/window.c、runtime/audio.c）を、名前のある関数と UM の enum にして使えるようにする。
// プログラムがこのファイルの名前（WindowEvent、pollWindowEvent、audioOpen など）を使うときだけ、
// ドライバが標準の関数として加える。
//
// 使い方:
//   const win = windowOpen("editor", 1280, 720);
//   if (win == null) { ... }
//   let running = true;
//   while (running) {
//     while (true) {
//       const e = pollWindowEvent(0);
//       if (e == null) { break; }
//       match (e) {
//         WindowEvent.Close(w) => { running = false; }
//         ...
//       }
//     }
//     windowPresent(win, pixels, 1280, 720);
//   }
//
// 操作番号（windowCtl などの第1引数）は runtime/window.c と runtime/audio.c の enum と揃えること。

// 修飾キー。
struct Mods {
  shift: bool;
  ctrl: bool;
  alt: bool;
  meta: bool;  // macOS の Command、Windows のキー
}

// キー。名前のあるキーのほかは、Char（文字のキー。英字は小文字）か Other（SDL のキーコード）。
enum Key {
  Enter,
  Escape,
  Backspace,
  Tab,
  Space,
  Delete,
  Left,
  Right,
  Up,
  Down,
  Home,
  End,
  PageUp,
  PageDown,
  F(n: i32),              // F1 〜 F12
  Char(codepoint: u32),   // 'a' のキーなら 97（Shift を押していても小文字。入力された文字は Text で受け取る）
  Other(code: i32),
}

// ウィンドウの状態。
struct WindowState {
  fullscreen: bool;
  maximized: bool;
  minimized: bool;
  focused: bool;   // キーボードの入力の焦点がある
  hidden: bool;
}

// 大きさ・位置・矩形。
struct WindowSize {
  width: i32;
  height: i32;
}

struct WindowPos {
  x: i32;
  y: i32;
}

struct DisplayRect {
  x: i32;
  y: i32;
  width: i32;
  height: i32;
}

// ファイルのダイアログの絞り込み。pattern は拡張子を ; で区切ったもの（"mp4;mov;mkv"）。"*" はすべて。
struct DialogFilter {
  name: string;
  pattern: string;
}

// マウスのカーソルの形（OS の標準のもの）。
enum CursorShape {
  Default,      // 矢印
  Text,         // 文字の入力（I の形）
  Wait,         // 待ち
  Crosshair,    // 十字
  Progress,     // 処理中だが操作できる（矢印と待ち）
  ResizeNWSE,   // 左上・右下の矢印
  ResizeNESW,   // 右上・左下の矢印
  ResizeEW,     // 左右の矢印
  ResizeNS,     // 上下の矢印
  Move,         // 上下左右の矢印
  NotAllowed,   // 禁止
  Pointer,      // 手（リンク・ボタン）
}

// ウィンドウのイベント。window は windowOpen が返した番号。座標はウィンドウの左上が (0, 0) のウィンドウの座標。
enum WindowEvent {
  Close(window: i32),                                     // 閉じるボタン（閉じるかどうかはプログラムが決める）
  Resize(window: i32, width: i32, height: i32),
  MouseMove(window: i32, x: i32, y: i32),
  MouseDown(window: i32, x: i32, y: i32, button: i32),    // button: 1 左、2 中、3 右
  MouseUp(window: i32, x: i32, y: i32, button: i32),
  Wheel(window: i32, dx: i32, dy: i32, fx: f64, fy: f64), // 上・右が正。dx, dy はノッチ（整数）、fx, fy は細かい量（ノッチ単位の小数。トラックパッドの滑らかなスクロール）
  KeyDown(window: i32, key: Key, mods: Mods, repeat: bool),
  KeyUp(window: i32, key: Key, mods: Mods),
  Text(window: i32, codepoint: u32),                      // 入力された文字（IME の確定も含む）
  Quit,                                                   // アプリの終了の要求
  // ファイルのドロップ。DropBegin → (DropPosition | DropFile | DropText)* → DropComplete の順に届く。
  DropBegin(window: i32),
  DropFile(window: i32, path: string, x: i32, y: i32),    // ファイルかフォルダ1つ（複数なら1つずつ届く）
  DropText(window: i32, text: string, x: i32, y: i32),
  DropPosition(window: i32, x: i32, y: i32),              // ドラッグ中の位置（落とす場所の強調に使う）
  DropComplete(window: i32, x: i32, y: i32),
  // IME で変換中の文字列（確定前）。text が空なら変換が終わった（確定した文字は Text で届く）。
  // start と length は選んでいる部分（文字の単位。なければ -1）。windowImeComposition(true) のときに届く。
  TextEditing(window: i32, text: string, start: i32, length: i32),
  Dialog(request: i32, paths: string[], filter: i32),     // ダイアログの結果。paths が空なら取り消し。filter は選んだ絞り込み（-1 は不明）
  DialogFailed(request: i32),                             // ダイアログを出せなかった
  PixelSizeChanged(window: i32, width: i32, height: i32), // 描画の面の画素の大きさが変わった
  ScaleChanged(window: i32, scale: f64),                  // 表示の倍率が変わった（別の倍率のディスプレイへ移した、など）
  Focus(window: i32, gained: bool),                       // キーボードの入力の焦点を得た・失った
  MouseEnter(window: i32),
  MouseLeave(window: i32),
  Moved(window: i32, x: i32, y: i32),                     // ウィンドウを動かした（画面の座標）
  StateChanged(window: i32, state: WindowState),          // 最大化・最小化・元に戻す・全画面の出入り
  Exposed(window: i32),                                   // 描き直しが要る
  DisplaysChanged,                                        // ディスプレイの増減・配置・倍率の変化
}

// SDL のキーコードを Key にする。
function keyOf(code: i32): Key {
  switch (code) {
    case 13: return Key.Enter;
    case 27: return Key.Escape;
    case 8: return Key.Backspace;
    case 9: return Key.Tab;
    case 32: return Key.Space;
    case 127: return Key.Delete;
    case 1073741904: return Key.Left;      // 0x40000050
    case 1073741903: return Key.Right;     // 0x4000004F
    case 1073741906: return Key.Up;        // 0x40000052
    case 1073741905: return Key.Down;      // 0x40000051
    case 1073741898: return Key.Home;      // 0x4000004A
    case 1073741901: return Key.End;       // 0x4000004D
    case 1073741899: return Key.PageUp;    // 0x4000004B
    case 1073741902: return Key.PageDown;  // 0x4000004E
  }
  if (code >= 1073741882 && code <= 1073741893) {  // F1（0x4000003A）〜 F12（0x40000045）
    return Key.F(code - 1073741881);
  }
  if (code > 32 && code < 1073741824) {  // 文字のキー（0x40000000 未満はコードポイント）
    return Key.Char(code as u32);
  }
  return Key.Other(code);
}

function modsOf(bits: i32): Mods {
  return { shift: (bits & 1) != 0, ctrl: (bits & 2) != 0, alt: (bits & 4) != 0, meta: (bits & 8) != 0 };
}

function windowStateOf(bits: i32): WindowState {
  return {
    fullscreen: (bits & 1) != 0, maximized: (bits & 2) != 0, minimized: (bits & 4) != 0,
    focused: (bits & 8) != 0, hidden: (bits & 16) != 0,
  };
}

// 最後に取り出したイベントの文字列を count 個。
function windowEventStrings(count: i32): string[] {
  let out: string[] = [];
  for (let i = 0; i < count; i++) {
    out.push(windowGetText(2, 0, i as i64));
  }
  return out;
}

// イベントを1つ取り出す。なければ timeoutMs ミリ秒まで待ち（0 は待たない、負は来るまで待つ）、来なければ null。
// 毎フレーム描き直すなら 0、入力があるまで寝ていてよいなら -1 か待ち時間を渡す。
function pollWindowEvent(timeoutMs: i32): WindowEvent | null {
  let ev = new Buffer<i32>(6);
  if (!windowPoll(mut ev, timeoutMs)) {
    return null;
  }
  const w = ev[1];
  switch (ev[0]) {
    case 1: return WindowEvent.Close(w);
    case 2: return WindowEvent.Resize(w, ev[2], ev[3]);
    case 3: return WindowEvent.MouseMove(w, ev[2], ev[3]);
    case 4: return WindowEvent.MouseDown(w, ev[2], ev[3], ev[4]);
    case 5: return WindowEvent.MouseUp(w, ev[2], ev[3], ev[4]);
    case 6: return WindowEvent.Wheel(w, ev[2], ev[3], (ev[4] as f64) / 1000.0, (ev[5] as f64) / 1000.0);
    case 7: return WindowEvent.KeyDown(w, keyOf(ev[2]), modsOf(ev[3]), ev[4] != 0);
    case 8: return WindowEvent.KeyUp(w, keyOf(ev[2]), modsOf(ev[3]));
    case 9: return WindowEvent.Text(w, ev[2] as u32);
    case 11: return WindowEvent.DropBegin(w);
    case 12: return WindowEvent.DropFile(w, windowGetText(2, 0, 0), ev[2], ev[3]);
    case 13: return WindowEvent.DropText(w, windowGetText(2, 0, 0), ev[2], ev[3]);
    case 14: return WindowEvent.DropPosition(w, ev[2], ev[3]);
    case 15: return WindowEvent.DropComplete(w, ev[2], ev[3]);
    case 16: return WindowEvent.TextEditing(w, windowGetText(2, 0, 0), ev[2], ev[3]);
    case 17: {
      if (ev[2] < 0) {
        return WindowEvent.DialogFailed(w);
      }
      return WindowEvent.Dialog(w, windowEventStrings(ev[2]), ev[3]);
    }
    case 18: return WindowEvent.PixelSizeChanged(w, ev[2], ev[3]);
    case 19: return WindowEvent.ScaleChanged(w, windowCtlF(1, w, 0));
    case 20: return WindowEvent.Focus(w, ev[2] != 0);
    case 21: {
      if (ev[2] != 0) {
        return WindowEvent.MouseEnter(w);
      }
      return WindowEvent.MouseLeave(w);
    }
    case 22: return WindowEvent.Moved(w, ev[2], ev[3]);
    case 23: return WindowEvent.StateChanged(w, windowStateOf(ev[2]));
    case 24: return WindowEvent.Exposed(w);
    case 25: return WindowEvent.DisplaysChanged;
  }
  return WindowEvent.Quit;
}

// windowCtl に渡す引数と結果の置き場。
function windowIo(): Buffer<i64> {
  return new Buffer<i64>(6);
}

// 引数をとらない・1つ・2つとる windowCtl。
function windowCtl0(op: i32, window: i32): i64 {
  let io = windowIo();
  return windowCtl(op, window, mut io);
}

function windowCtl1(op: i32, window: i32, a: i64): i64 {
  let io = windowIo();
  io[0] = a;
  return windowCtl(op, window, mut io);
}

function windowCtl2(op: i32, window: i32, a: i64, b: i64): i64 {
  let io = windowIo();
  io[0] = a;
  io[1] = b;
  return windowCtl(op, window, mut io);
}

// 結果を io[0], io[1] に書く windowCtl を Size にする。
function windowCtlSize(op: i32, window: i32): WindowSize {
  let io = windowIo();
  windowCtl(op, window, mut io);
  return { width: io[0] as i32, height: io[1] as i32 };
}

// ---- ウィンドウの操作 ----

// SDL の最後の失敗の理由（windowOpen・audioOpen が null を返したときなど）。
function windowError(): string {
  return windowGetText(5, 0, 0);
}

function windowSetTitle(window: i32, title: string): bool {
  return windowSetText(1, window, 0, title) != 0;
}

function windowTitle(window: i32): string {
  return windowGetText(4, window, 0);
}

// 大きさ（ウィンドウの座標。windowOpen に渡した単位）。
function windowSetSize(window: i32, width: i32, height: i32): bool {
  return windowCtl2(1, window, width as i64, height as i64) != 0;
}

function windowSize(window: i32): WindowSize {
  return windowCtlSize(2, window);
}

// 位置（画面の座標。ディスプレイをまたぐと負にもなる）。
function windowSetPosition(window: i32, x: i32, y: i32): bool {
  return windowCtl2(3, window, x as i64, y as i64) != 0;
}

function windowPosition(window: i32): WindowPos {
  let io = windowIo();
  windowCtl(4, window, mut io);
  return { x: io[0] as i32, y: io[1] as i32 };
}

// 利用者がこれより小さくできないようにする（0, 0 で制限なし）。
function windowSetMinimumSize(window: i32, width: i32, height: i32): bool {
  return windowCtl2(5, window, width as i64, height as i64) != 0;
}

function windowMaximize(window: i32): bool {
  return windowCtl0(6, window) != 0;
}

function windowMinimize(window: i32): bool {
  return windowCtl0(7, window) != 0;
}

// 最大化・最小化から戻す。
function windowRestore(window: i32): bool {
  return windowCtl0(8, window) != 0;
}

// 全画面（デスクトップの解像度のまま、ウィンドウの枠をなくして画面を覆う）。
function windowSetFullscreen(window: i32, on: bool): bool {
  return windowCtl1(9, window, on ? 1 : 0) != 0;
}

function windowState(window: i32): WindowState {
  return windowStateOf(windowCtl0(10, window) as i32);
}

function windowSetResizable(window: i32, on: bool): bool {
  return windowCtl1(26, window, on ? 1 : 0) != 0;
}

// 前に出して焦点を移す。
function windowRaise(window: i32): bool {
  return windowCtl0(23, window) != 0;
}

// 表示（windowPresent）を画面の更新に合わせるか（windowOpen の直後は合わせる）。
function windowSetVSync(window: i32, on: bool): bool {
  return windowCtl1(22, window, on ? 1 : 0) != 0;
}

// ---- 高密度の画面（HiDPI）とディスプレイ ----
// くっきり描くには、windowPixelSize の大きさの Buffer に描いて windowPresent に渡す。
// 文字やボタンは windowDisplayScale 倍の大きさで描く（Windows の 150% の設定なら 1.5）。
// マウスの座標はウィンドウの座標なので、画素の位置は windowPixelDensity 倍する。

// 描画の面の画素の大きさ。
function windowPixelSize(window: i32): WindowSize {
  return windowCtlSize(11, window);
}

// ウィンドウの座標 1 あたりの画素の数（macOS の Retina なら 2。Windows ではふつう 1）。
function windowPixelDensity(window: i32): f64 {
  return windowCtlF(2, window, 0);
}

// UI を大きく描く倍率（ディスプレイの拡大の設定と画素の密度をあわせたもの）。
function windowDisplayScale(window: i32): f64 {
  return windowCtlF(1, window, 0);
}

// ウィンドウのあるディスプレイの番号（0 から。分からなければ -1）。
function windowDisplay(window: i32): i32 {
  return windowCtl0(12, window) as i32;
}

function displayCount(): i32 {
  return windowCtl0(13, 0) as i32;
}

// ディスプレイの範囲（画面の座標）。番号が正しくなければ null。
function displayBounds(index: i32): DisplayRect | null {
  let io = windowIo();
  io[0] = index as i64;
  if (windowCtl(14, 0, mut io) == 0) {
    return null;
  }
  return { x: io[0] as i32, y: io[1] as i32, width: io[2] as i32, height: io[3] as i32 };
}

// タスクバーやメニューバーを除いた範囲。
function displayUsableBounds(index: i32): DisplayRect | null {
  let io = windowIo();
  io[0] = index as i64;
  if (windowCtl(15, 0, mut io) == 0) {
    return null;
  }
  return { x: io[0] as i32, y: io[1] as i32, width: io[2] as i32, height: io[3] as i32 };
}

function displayName(index: i32): string {
  return windowGetText(3, 0, index as i64);
}

// ディスプレイの拡大の設定（125% なら 1.25。番号が正しくなければ 0）。
function displayContentScale(index: i32): f64 {
  return windowCtlF(3, 0, index as i64);
}

// 画面の更新の頻度（Hz。分からなければ 0）。
function displayRefreshRate(index: i32): f64 {
  return windowCtlF(4, 0, index as i64);
}

// ---- 文字の入力と IME ----

// IME で変換中の文字列をプログラムが描くか（true なら TextEditing が届き、OS は変換中の文字列を描かない。
// 変換の候補の一覧は OS が windowSetTextInputArea の近くに出す）。最初の windowOpen より前に呼ぶ。後では false を返す。
function windowImeComposition(on: bool): bool {
  return windowCtl1(24, 0, on ? 1 : 0) != 0;
}

// 文字の入力を始める・止める（windowOpen の直後は入力中）。止めると Text と TextEditing が届かなくなり、
// 文字のキーがすべて KeyDown で届く（ショートカットだけの画面向け）。
function windowStartTextInput(window: i32): bool {
  return windowCtl0(16, window) != 0;
}

function windowStopTextInput(window: i32): bool {
  return windowCtl0(17, window) != 0;
}

function windowTextInputActive(window: i32): bool {
  return windowCtl0(18, window) != 0;
}

// 入力欄の場所（ウィンドウの座標）と、欄の中のカーソルの x（欄の左端から）。IME の候補の一覧がこの近くに出る。
function windowSetTextInputArea(window: i32, x: i32, y: i32, width: i32, height: i32, cursor: i32): bool {
  let io = windowIo();
  io[0] = x as i64;
  io[1] = y as i64;
  io[2] = width as i64;
  io[3] = height as i64;
  io[4] = cursor as i64;
  return windowCtl(19, window, mut io) != 0;
}

// ---- カーソル ----

// SDL_SystemCursor の番号。
function cursorShapeCode(c: CursorShape): i64 {
  let code: i64 = 0;
  match (c) {
    CursorShape.Default => { code = 0; }
    CursorShape.Text => { code = 1; }
    CursorShape.Wait => { code = 2; }
    CursorShape.Crosshair => { code = 3; }
    CursorShape.Progress => { code = 4; }
    CursorShape.ResizeNWSE => { code = 5; }
    CursorShape.ResizeNESW => { code = 6; }
    CursorShape.ResizeEW => { code = 7; }
    CursorShape.ResizeNS => { code = 8; }
    CursorShape.Move => { code = 9; }
    CursorShape.NotAllowed => { code = 10; }
    CursorShape.Pointer => { code = 11; }
  }
  return code;
}

// カーソルの形を変える（すべてのウィンドウで同じ）。
function windowSetCursor(c: CursorShape): bool {
  return windowCtl1(20, 0, cursorShapeCode(c)) != 0;
}

function windowShowCursor(show: bool): bool {
  return windowCtl1(21, 0, show ? 1 : 0) != 0;
}

// ---- クリップボード ----

function clipboardText(): string {
  return windowGetText(1, 0, 0);
}

function clipboardSetText(text: string): bool {
  return windowSetText(2, 0, 0, text) != 0;
}

function clipboardHasText(): bool {
  return windowCtl0(25, 0) != 0;
}

// ---- ファイルのダイアログ ----
// どれもすぐに戻り、要求の番号を返す（出せなければ null）。結果は後で WindowEvent.Dialog(request, paths, filter) で届く。
// window は親にするウィンドウ（0 なら親なし）、title と location は空なら OS に任せる。

function windowDialogPrepare(title: string, location: string, filters: DialogFilter[]): void {
  windowCtl0(43, 0);
  if (title.length > 0) {
    windowSetText(3, 0, 0, title);
  }
  if (location.length > 0) {
    windowSetText(4, 0, 0, location);
  }
  for (const f of filters) {
    windowSetText(5, 0, 0, `${f.name}|${f.pattern}`);
  }
}

function windowDialogRequest(r: i64): i32 | null {
  if (r == 0) {
    return null;
  }
  return r as i32;
}

// 開く。many が true なら複数を選べる。
function windowOpenFileDialog(window: i32, title: string, location: string, filters: DialogFilter[], many: bool): i32 | null {
  windowDialogPrepare(title, location, filters);
  return windowDialogRequest(windowCtl1(40, window, many ? 1 : 0));
}

// 保存。location にファイルの名前まで入れると、それが最初に入る。
function windowSaveFileDialog(window: i32, title: string, location: string, filters: DialogFilter[]): i32 | null {
  windowDialogPrepare(title, location, filters);
  return windowDialogRequest(windowCtl1(41, window, 0));
}

// フォルダを選ぶ。
function windowOpenFolderDialog(window: i32, title: string, location: string, many: bool): i32 | null {
  windowDialogPrepare(title, location, []);
  return windowDialogRequest(windowCtl1(42, window, many ? 1 : 0));
}

// ---- 時刻 ----
// どのスレッドからも呼べる。SDL3 をリンクする（clock() は SDL3 なしで使える秒の時計）。

// 逆戻りしない時計（ナノ秒）。起点は決まっていない（SDL を初期化する前の最初の呼び出しでは 0）ので、差だけを使う。
function ticksNs(): i64 {
  return windowCtl0(30, 0);
}

// ns ナノ秒だけ眠る。1 ミリ秒より短くても正確（最後は待ち続けて合わせる）。
function sleepNs(ns: i64): void {
  windowCtl1(31, 0, ns);
}

function sleepMs(ms: i64): void {
  windowCtl1(31, 0, ms * 1000000);
}

// ---- 音の出力 ----
// 標本は f32（-1.0 〜 1.0）で、チャンネルを交互に並べる（ステレオなら L R L R ...）。1 フレーム = チャンネルの数の標本。
// 開く・閉じるはメインスレッドから。ほかはどのスレッドからも呼べる。
// 映像との同期: 今の再生位置（秒）≒ (audioPlayed(s) - audioLatency(s)) / 標本化周波数。

// 既定の出力のデバイスを開き、出力の番号を返す。音のデバイスがなければ null（理由は windowError）。
// 一時停止の状態で開くので、少し書き込んでから audioResume で鳴らし始める。
function audioOpen(sampleRate: i32, channels: i32): i32 | null {
  const s = windowCtl2(100, 0, sampleRate as i64, channels as i64);
  if (s == 0) {
    return null;
  }
  return s as i32;
}

function audioClose(stream: i32): void {
  windowCtl0(101, stream);
}

// まだ鳴らしていない（待ち行列にある）フレームの数。これが減ったら書き足す。
function audioQueued(stream: i32): i64 {
  return windowCtl0(102, stream);
}

function audioPause(stream: i32): bool {
  return windowCtl0(103, stream) != 0;
}

function audioResume(stream: i32): bool {
  return windowCtl0(104, stream) != 0;
}

function audioPaused(stream: i32): bool {
  return windowCtl0(107, stream) != 0;
}

// 待ち行列を捨てる（シークのとき）。捨てた分は audioPlayed に数えない。
function audioClear(stream: i32): bool {
  return windowCtl0(105, stream) != 0;
}

// 開いてから再生した（デバイスに渡った）フレームの数。時計に使う。
function audioPlayed(stream: i32): i64 {
  return windowCtl0(106, stream);
}

// 開いてから書き込んだフレームの数（消去した分を引く）。
function audioWritten(stream: i32): i64 {
  return windowCtl0(109, stream);
}

// デバイスの中にたまる分のフレームの数（デバイスに渡ってから耳に届くまでの遅れ。分からなければ 0）。
function audioLatency(stream: i32): i64 {
  return windowCtl0(108, stream);
}

// 音量（1.0 で元のまま）。
function audioSetGain(stream: i32, gain: f64): bool {
  return windowCtl1(110, stream, (gain * 1000.0) as i64) != 0;
}
