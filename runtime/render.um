// 描画の標準の型と関数（docs/render.ja.md）。プログラムが gpu.beginImage / gpu.draw / gpu.endImage を使うときだけ、
// ドライバが標準の関数として加える。
//
// 画像は GpuImage。GPU で描けるとき（UM_WGPU=1 のビルドで GPU が使えるとき）は handle に GPU の画像の番号（1 以上）を持ち、
// 描画は GPU のラスタライザが行う。そうでないとき handle は 0 で、色と深度を color / depth に持ち、描画は CPU で行う
// （gpu.draw ごとにコンパイラが作る関数 umRenderDraw__vs__fs。src/render.ts の drawSource）。
// どちらでも同じプログラムが動き、同じ画像になる（三角形の辺がちょうど画素の中心を通るときと、補間の誤差を除く）。

// 面の向きで捨てるか（gpu.draw の前に image.cull に入れる）。表は、画面で反時計回りに並ぶ三角形（GPU の既定と同じ）。
enum CullMode {
  None,   // 裏表とも描く（既定）
  Back,   // 裏を向いた面を描かない
  Front,  // 表を向いた面を描かない
}

// 色の混ぜ方（image.blend）。色は fragment function の値を 0〜1 に収めてから混ぜる。
enum BlendMode {
  Opaque,  // 上書きする（既定）
  Alpha,   // 不透明度で重ねる: 色 = src × a + dst × (1 − a)
  Add,     // 足す（光・炎など）: 色 = src × a + dst
}

class GpuImage {
  width: i32;
  height: i32;
  handle: i32;
  color: Buffer<u32>;
  depth: Buffer<f32>;
  // ウィンドウに描くフレーム（gpu.beginFrame）なら、そのウィンドウの番号。画像（gpu.beginImage）なら 0。
  window: i32 = 0;
  // 描き方。gpu.draw のたびに、そのときの値で描く。
  cull: CullMode = CullMode.None;
  blend: BlendMode = BlendMode.Opaque;
  // 深度を書くか（半透明のものは、深度を比べるだけで書かないことが多い）。
  depthWrite: bool = true;

  constructor(width: i32, height: i32, handle: i32, clear: u32) {
    this.width = width;
    this.height = height;
    this.handle = handle;
    // GPU で描くときは、CPU 側の色と深度は使わない。
    let n: u32 = 0;
    if (handle == 0 && width > 0 && height > 0) {
      n = (width as u32) * (height as u32);
    }
    this.color = new Buffer<u32>(n as usize);
    this.depth = new Buffer<f32>(n as usize);
    this.color.fill(clear);
    this.depth.fill(1);
  }
}

// gpu.beginImage(width, height, clear)
function __std_gpuBeginImage(width: i32, height: i32, clear: u32): GpuImage {
  return new GpuImage(width, height, gpu.rawBeginImage(width, height, clear), clear);
}

// gpu.endImage(mut image, mut pixels)。画素を写し、GPU の画像を片づける（あとは CPU の空の画像として残る）。
function __std_gpuEndImage(image: mut GpuImage, pixels: mut Buffer<u32>): void {
  if (image.handle != 0) {
    gpu.rawEndImage(image.handle, mut pixels);
    image.handle = 0;
    return;
  }
  const n = image.color.length;
  for (let i: u32 = 0; i < n; i++) {
    pixels[i] = image.color[i];
  }
}

// fragment function の色（0〜1 の浮動小数点）を 0xAARRGGBB にする。GPU の BGRA8Unorm と同じく、
// 0〜1 に収めてから 255 倍して最も近い整数にする（NaN は 0）。
kernel function __std_renderUnorm8(v: f32): u32 {
  if (!(v > 0)) {
    return 0;
  }
  if (v >= 1) {
    return 255;
  }
  return Math.floor(v * 255 + 0.5) as u32;
}

kernel function __std_renderPack(c: vec4<f32>): u32 {
  return (__std_renderUnorm8(c.w) << 24) | (__std_renderUnorm8(c.x) << 16) | (__std_renderUnorm8(c.y) << 8) | __std_renderUnorm8(c.z);
}

// 三角形の辺 p → q の上か左か（辺の上の画素の中心を、どちらの三角形が塗るかの決まり。GPU と同じ top-left rule）。
// 画面の座標は y が下向きで、三角形は内側の辺の関数が正になる向き。
kernel function __std_renderTopLeft(dx: f32, dy: f32): bool {
  return (dy == 0 && dx > 0) || dy < 0;
}

// 辺の関数の値 e が、その辺について内側か。
kernel function __std_renderInside(e: f32, dx: f32, dy: f32): bool {
  return e > 0 || (e == 0 && __std_renderTopLeft(dx, dy));
}

// 描き方を GPU のランタイムに渡すビット（runtime/wgpu.c の um_gpu_draw_state と揃える）。
function __std_renderCullCode(c: CullMode): i32 {
  match (c) {
    CullMode.None => { return 0; }
    CullMode.Back => { return 1; }
    CullMode.Front => { return 2; }
  }
}

function __std_renderBlendCode(b: BlendMode): i32 {
  match (b) {
    BlendMode.Opaque => { return 0; }
    BlendMode.Alpha => { return 1; }
    BlendMode.Add => { return 2; }
  }
}

function __std_renderState(img: GpuImage): i32 {
  let st = __std_renderCullCode(img.cull) | (__std_renderBlendCode(img.blend) << 2);
  if (!img.depthWrite) {
    st = st | 16;
  }
  return st;
}

// 三角形を面の向きで捨てるか。area は画面の座標（y が下向き）での符号つきの面積の 2 倍で、負なら画面で反時計回り（表）。
function __std_renderCulled(cull: i32, area: f32): bool {
  if (cull == 1) {
    return !(area < 0);
  }
  if (cull == 2) {
    return area < 0;
  }
  return false;
}

// 0〜1 に収める（NaN は 0）。
kernel function __std_renderSat(v: f32): f32 {
  if (!(v > 0)) {
    return 0;
  }
  if (v >= 1) {
    return 1;
  }
  return v;
}

// 色 c を、画素の今の色 dst と混ぜて 0xAARRGGBB にする（blend は __std_renderBlendCode）。GPU の混ぜ方と同じ式。
kernel function __std_renderBlend(blend: i32, c: vec4<f32>, dst: u32): u32 {
  if (blend == 0) {
    return __std_renderPack(c);
  }
  const a = __std_renderSat(c.w);
  const dr = (((dst >> 16) & 255) as f32) / 255;
  const dg = (((dst >> 8) & 255) as f32) / 255;
  const db = ((dst & 255) as f32) / 255;
  const da = (((dst >> 24) & 255) as f32) / 255;
  let k: f32 = 1;
  if (blend == 1) {
    k = 1 - a;
  }
  const r = __std_renderSat(c.x) * a + dr * k;
  const g = __std_renderSat(c.y) * a + dg * k;
  const b = __std_renderSat(c.z) * a + db * k;
  return __std_renderPack(vec4(r, g, b, a + da * (1 - a)));
}
